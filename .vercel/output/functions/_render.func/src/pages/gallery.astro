---
import Layout from "@/layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import { Image } from "astro:assets";
import 'swiper/css';
import "swiper/css/navigation";

const title: string = "Galeria";
const subTitle: string = "";
---

<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <TitleSection
                title={ title }
                subTitle={ subTitle }
            />
        </div>
        <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
            <!-- Contenedor principal de Swiper -->
            <div class="swiper w-auto">
                <!-- Wrapper adicional requerido -->
                <div class="swiper-wrapper w-auto lg:max-w-5xl xl:max-w-6xl">
                <!-- Los slides -->
                    <div class="swiper-slide">
                        <!-- <Image src="/images/image1.jpg" alt="" width={800} height={600} /> -->
                        <img src="/images/image1.jpg" alt="" />
                    </div>
                    <div class="swiper-slide">
                        <!-- <Image src="/images/image2.jpg" alt="" width={800} height={600} /> -->
                        <img src="/images/image2.jpg" alt="" />
                    </div>
                    <div class="swiper-slide">
                        <!-- <Image src="/images/image3.jpg" alt="" width={800} height={600} /> -->
                        <img src="/images/image3.jpg" alt="" />
                    </div>
                    <div class="swiper-slide">
                        <!-- <Image src="/images/image4.jpg" alt="" width={800} height={600} /> -->
                        <img src="/images/image4.jpg" alt="" />
                    </div>
                    <div class="swiper-slide">
                        <!-- <Image src="/images/image5.jpg" alt="" width={800} height={600} /> -->
                        <img src="/images/image5.jpg" alt="" />
                    </div>
                </div>
                <!-- Si necesitamos botones de navegación -->
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
        </div>
    </section>
</Layout>
<style>
    .swiper {
        /* width: 600px;
        height: 300px; */
    }
    .swiper-slide {
        /* height: 600px; */
        border-radius: 10px;
        overflow: hidden;
    }
    .swiper-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .swiper-button-next,
    .swiper-button-prev {
        /* background-color: white; */
        width: 60px;
        height: 60px;
        border-radius: 10px;
        text-decoration: none;
    }
    /* .swiper-button-prev {
        transform: rotate(180deg); /* rotar arrow-next.svg para reutilizar el mismo icono*/
   /* } */
    /* .swiper-button-next::after,
    .swiper-button-prev::after {
        content: "";
    } */
</style>
<script>
    // Core de Swiper y estilos
    import Swiper from 'swiper';

    // Módulo Navigation de Swiper y estilos
    import { Navigation } from "swiper/modules";


    // Configurar Swiper
    const swiper = new Swiper(".swiper", {
        modules: [Navigation], // definir los módulos a usar
        loop: true,            // definir si los slides estarán en bucle
        slidesPerView: "auto",      // agregar número de slides para la pantalla
        spaceBetween: 40,      // separación entre slides en px
        breakpoints: {
            // Cuando la pantalla es >= 768px
            768: {
            slidesPerView: 2,
            spaceBetween: 30
            },
            // Cuando la pantalla es >= 1024px
            1024: {
            slidesPerView: 3,
            spaceBetween: 40
            }
        },
        navigation: {          // definir botones next y prev para el módulo Navigation
            prevEl: ".swiper-button-prev",
            nextEl: ".swiper-button-next",
        }
    });
</script>