---
import Layout from "@/layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import SinglePostCard from "@/components/ui/SinglePostCard.astro"; // Nuevo componente para cards

const allPostsFile = import.meta.glob('@posts/*.md', { eager: true });

const allPosts = Object.entries(allPostsFile).map(([filePath, post]) => {
    const flatPost = Object.assign({}, post) as { frontmatter: { pubDate?: string } };
    const slug = filePath.replace('/src/pages/posts/', '').replace('.md', '');
    return {
        ...flatPost,
        url: `/posts/${slug}`,
        pubDate: new Date(flatPost.frontmatter?.pubDate || 0),
    };
});
const allPostsTags = Object.values(import.meta.glob('@posts/*.md', { eager: true }));
const allTags = allPostsTags.map((post) => (post as { frontmatter: { tags: string[] } }).frontmatter.tags).flat();
const tagCounts = allTags.reduce((acc: Record<string, number>, tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
}, {} as Record<string, number>);
const tags = Object.keys(tagCounts);
const sortedPosts = allPosts.sort((a, b) =>
    (b?.pubDate?.getTime() || 0) - (a?.pubDate?.getTime() || 0)
);

const title = "Explora el Universo Geek";
const subTitle = "Descubre artículos, reviews y guías para fans";
const arrowSVG = `<svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>`;
---
<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <!-- Header con efecto especial -->
        <div class="mx-auto max-w-4xl text-center">
            <TitleSection
                title={title}
                subTitle={subTitle}
            />
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <button class="filter-btn active">Todos</button>
                <!-- <button class="filter-btn">🎮 Gaming</button>
                <button class="filter-btn">🤖 Tecnología</button>
                <button class="filter-btn">📺 Anime</button> -->
                {
                    tags.map((tag) => (
                    <button class="filter-btn">
                        <a href={`/tags/${tag}`}>
                            {tag}
                        </a>
                    </button>
                    ))
                }
            </div>
        </div>

        <!-- Grid de Cards Verticales -->
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {sortedPosts.map((post, index) => {
                return (
                    <SinglePostCard
                        link = { {href:post.url,text:"Continuar Leyendo"} }
                        title = { (post.frontmatter as Frontmatter)?.title || "Sin título"}
                        text = { (post.frontmatter as Frontmatter)?.description }
                        image = { (post.frontmatter as Frontmatter)?.image}
                        pubDate = { (post.frontmatter as Frontmatter)?.pubDate }
                        tags = { (post.frontmatter as Frontmatter)?.tags}
                        author = { (post.frontmatter as Frontmatter)?.author}
                        svg={arrowSVG}
                        key={index}
                    />
                );
            })}
        </div>

        <!-- Paginación Estilizada -->
        <div class="mt-16 flex justify-center gap-2">
            <button class="pagination-btn">← Anterior</button>
            <button class="pagination-btn active">1</button>
            <button class="pagination-btn">2</button>
            <button class="pagination-btn">Siguiente →</button>
        </div>
    </section>

    <style>
        .filter-btn {
            @apply rounded-full px-4 py-2 text-sm font-medium bg-neutral-800 text-neutral-300 hover:bg-amber-400/10 hover:text-amber-400 transition-all duration-300;
        }
        .filter-btn.active {
            @apply bg-gradient-to-r from-amber-500/80 to-amber-600 text-neutral-900 font-bold;
        }
        .pagination-btn {
            @apply rounded-md px-4 py-2 bg-neutral-800 text-neutral-300 hover:bg-amber-500 hover:text-neutral-900 transition-colors border border-neutral-700;
        }
        .pagination-btn.active {
            @apply bg-amber-500 text-neutral-900 border-amber-500;
        }
    </style>
</Layout>