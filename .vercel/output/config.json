{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/404\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/about\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/blog\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/gallery\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/css-grid-layout-tutorial\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/flexbox-guia-completa-diseno-responsive\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/menu-navegacion-html-css-hover-efectos\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/postgres-backup-restore-guide\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/tag-cloud-tutorial\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/robots\\.txt\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/tags\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		},
		{
			"src": "/.*",
			"dest": "_render",
			"status": 404
		}
	]
}