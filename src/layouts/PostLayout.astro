---
import Layout from '@layouts/Layout.astro';
import TitleSection from '@/components/ui/TitleSection.astro';
import TitlePost from '@/components/ui/TitlePost.astro';
import '@styles/markdown.css';
const { frontmatter, compiledContent } = Astro.props;
const contentHtml = await compiledContent();
---
<Layout>
    <article class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <header class="text-neutral-200">
            <TitlePost
                title={frontmatter.title}
                subTitle={frontmatter.description}
            />
            <p>Publicado el: {frontmatter.pubDate.toString().slice(0,10)}</p>
            <p>Escrito por: {frontmatter.author}</p>
            <img class="w-auto py-3 center" src={frontmatter.image.url} width="350" alt={frontmatter.image.alt} />
            <div class="flex flex-wrap">
                {frontmatter.tags.map((tag: string) => (
                    <p class="border-dotted	m-1 rounded-lg px-4 py-2 text-lg">
                        <a href={`/tags/${tag}`}>{tag}</a>
                    </p>
                ))}
            </div>
        </header>
        <hr/>
        <br/>
        <section id="content-post" class="content-markdown" set:html={contentHtml}>
        </section>
    </article>
</Layout>