---
import Layout from '@layouts/Layout.astro';
import TitlePost from '@/components/ui/post/TitlePost.astro';
import { Icon } from "astro-icon/components";
import '@styles/markdown.css';

const { frontmatter } = Astro.props;
const images = import.meta.glob('../assets/images/posts/*.{jpg,png,webp,avif}');
let imageLocalUrl = null;

if (frontmatter.image?.url) {
    const imageFileName = frontmatter.image.url.split('/').pop();
    const imageKey = Object.keys(images).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await images[imageKey]();
            imageLocalUrl = (module as { default: any }).default;
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
        }
    }
}

// Formateo de fecha técnico
const publishDate = new Date(frontmatter.pubDate).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'short',
    day: '2-digit'
}).toUpperCase();
---

<Layout title={`${frontmatter.title} | Geekeando`}>
    <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12 bg-neutral-950">
        
        {/* Encabezado del Post */}
        <header class="mb-12 ">
            {/* Imagen de Portada con marco de visor */}
            { imageLocalUrl && (
                <div class="relative group mb-10 overflow-hidden rounded-xl border border-neutral-800 shadow-2xl">
                    <div class="absolute inset-0 z-10 bg-gradient-to-t from-neutral-950/50 to-transparent"></div>
                    <img 
                        src={imageLocalUrl.src} 
                        alt={frontmatter.image.alt ?? ''} 
                        class="w-full h-[400px] object-cover transition-transform duration-1000 group-hover:scale-105"
                    />
                    <div class="absolute bottom-4 left-4 z-20 flex items-center gap-2">
                        <span class="text-[10px] font-mono bg-amber-500 text-neutral-950 px-2 py-1 font-bold">
                            FILE_VIEWER_V1.0
                        </span>
                    </div>
                </div>
            )}

            {/* Metadatos de Cabecera */}
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6 font-mono text-[11px] text-neutral-500 border-b border-neutral-900 pb-4">
                <div class="flex items-center gap-4">
                    <span class="flex items-center gap-1">
                        <Icon name="mdi:account-circle-outline" class="h-4 w-4 text-amber-500/50" />
                        AUTH::{frontmatter.author.toUpperCase()}
                    </span>
                    <span class="flex items-center gap-1">
                        <Icon name="mdi:calendar-clock" class="h-4 w-4 text-amber-500/50" />
                        LOGGED::{publishDate}
                    </span>
                </div>
                <div class="text-amber-500/40">
                    ID: {Math.random().toString(36).substring(7).toUpperCase()}
                </div>
            </div>

            <TitlePost
                title={frontmatter.title}
                subTitle={frontmatter.description}
            />

            {/* Etiquetas estilo Terminal */}
            <div class="mt-8 flex flex-wrap gap-3">
                {frontmatter.tags.map((tag: string) => (
                    <a 
                        href={`/tags/${tag}`} 
                        class="text-[10px] font-mono border border-neutral-800 bg-neutral-900/50 px-3 py-1 text-neutral-400 hover:text-amber-500 hover:border-amber-500/50 transition-all"
                    >
                        {`#${tag.toUpperCase()}`}
                    </a>
                ))}
            </div>
        </header>

        {/* Separador Técnico */}
        <div class="flex items-center gap-4 mb-12">
            <div class="h-px flex-grow bg-neutral-900"></div>
            <div class="text-[10px] font-mono text-neutral-700 tracking-[0.5em]">CONTENT_START</div>
            <div class="h-px flex-grow bg-neutral-900"></div>
        </div>

        {/* Contenido Markdown */}
        <section id="content-post" class="content-markdown prose prose-invert prose-amber max-w-none font-sans text-sm md:text-base leading-relaxed ">
            
            <slot />
        </section>

        {/* Footer del Post */}
        <footer class="mt-20 pt-10 border-t border-neutral-900">
            <div class="flex justify-center">
                <a href="/blogs" class="group flex items-center gap-2 font-mono text-[11px] text-neutral-500 hover:text-amber-500 transition-colors">
                    <Icon name="mdi:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
                    RETURN_TO_ARCHIVE
                </a>
            </div>
        </footer>
    </article>
</Layout>

<style is:global>
    /* Títulos internos del post (h2, h3) */
    .content-markdown h2, 
    .content-markdown h3 {
      font-family: 'Orbitron', sans-serif !important;
      @apply text-white uppercase tracking-tighter mt-12 mb-6 border-l-4 border-amber-500 pl-4 bg-neutral-900/30 py-2;
    }
  
    /* Párrafos y listas */
    .content-markdown p, 
    .content-markdown li {
      font-family: 'Inter', sans-serif;
      @apply text-neutral-400 leading-relaxed mb-4 text-justify;
      letter-spacing: -0.01em;
    }
  
    /* Resaltado de código en línea (como el "display: grid;" que se ve en la imagen) */
    .content-markdown :not(pre) > code {
      @apply bg-amber-500/10 text-amber-500 px-1.5 py-0.5 rounded border border-amber-500/20 font-mono text-sm;
    }
  </style>

<script>
    // Mejora de bloques de código
    const codeBlocks = document.querySelectorAll('pre');
    codeBlocks.forEach(block => {
        const language = block.getAttribute('data-language') || 'code';
        const header = document.createElement('div');
        header.classList.add('language-header');
        header.textContent = `SHELL::${language}`;
        block.parentNode?.insertBefore(header, block);
    });
</script>