---
//import '@styles/global.css'
import NavHeader from '@components/NavHeaderMenu.astro'
import FooterSection from '@components/FooterSection.astro'
---

<!doctype html>
<html lang="en" class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ser Geek también es un trabajo" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<!-- <meta name="generator" content={Astro.generator} /> -->
		<title>GeekEando</title>
	</head>
	<body class="bg-neutral-800 selection:bg-yellow-400 selection:text-neutral-700">
		<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
			<NavHeader />
			<main class="p-8">
				<slot />
			</main>
		</div>
		<FooterSection />
		<style>
			/* CSS rules for the page scrollbar */
			.scrollbar-hide::-webkit-scrollbar {
				display: none;
			}
			.scrollbar-hide {
				-ms-overflow-style: none;
				scrollbar-width: none;
			}
		</style>
		<script>import "preline/dist/preline.js";</script>
		
	</body>
</html>
