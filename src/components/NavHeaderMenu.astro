---
import Link from "@components/ui/LinkMenu.astro";
import stringsNavigation from "@utils/stringsNavigation";
import BrandLogo from "@components/BrandLogo.astro";
import { Icon } from 'astro-icon/components';

const navigation = stringsNavigation;
const homeUrl = "/";
const themeSwitcher = true;
---

<header class="sticky inset-x-0 top-0 z-50 w-full backdrop-blur-md transition-all duration-300 border-b border-transparent [&.scrolled]:border-neutral-800/50 [&.scrolled]:bg-neutral-900/90">
    <div id="scroll-progress" class="absolute bottom-0 left-0 h-[2px] w-0 bg-gradient-to-r from-amber-500 to-orange-600 shadow-[0_0_10px_rgba(245,158,11,0.5)] transition-all duration-150 ease-out z-[60]"></div>

    <nav class="relative mx-auto flex max-w-[85rem] items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Global">
        <div class="flex items-center">
            <a href={homeUrl} class="outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-lg transition-transform hover:scale-[1.02]">
                <BrandLogo />
                <span class="sr-only">Geekeando</span>
            </a>
        </div>

        <div class="hidden md:flex md:items-center md:gap-x-8">
            <div class="flex gap-x-1 rounded-full text-neutral-400 bg-neutral-800/40 p-1 border border-neutral-700/30 backdrop-blur-sm">
                {navigation.navBarLinks.map((nav) => (
                    <Link
                        url={nav.url}
                        name={nav.name}
                        class="px-4 py-2 text-sm font-medium rounded-full transition-all hover:text-amber-400"
                        activeClass="bg-amber-500/20 text-amber-400"
                    />
                ))}
            </div>

            <div class="flex items-center gap-x-3">
                <a href="/contacto" class="group inline-flex items-center gap-x-2 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 px-5 py-2 text-sm font-bold text-neutral-900 hover:shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all">
                    Contacto
                    <Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </a>
            </div>
        </div>

        <div class="flex md:hidden">
            <button type="button" class="hs-collapse-toggle flex h-10 w-10 items-center justify-center rounded-full text-neutral-400" data-hs-collapse="#navbar-collapse">
                <Icon name="mdi:menu" class="h-6 w-6 hs-collapse-open:hidden" />
                <Icon name="mdi:close" class="hidden h-6 w-6 hs-collapse-open:block" />
            </button>
        </div>
    </nav>

    <div id="navbar-collapse" class="hs-collapse hidden mx-4 mt-2 rounded-2xl border border-neutral-700/40 bg-neutral-900 shadow-2xl md:hidden">
        <div class="flex flex-col gap-y-2 p-4">
            {navigation.navBarLinks.map((nav) => (
                <Link url={nav.url} name={nav.name} class="px-4 py-3 rounded-xl text-base" activeClass="text-amber-400 border-l-4 border-amber-500" />
            ))}
        </div>
    </div>
</header>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const header = document.querySelector('header');
        const progressBar = document.getElementById('scroll-progress');

        const updateUI = () => {
            const scrollY = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            
            // 1. Efecto de scroll en header
            header?.classList.toggle('scrolled', scrollY > 20);

            // 2. Cálculo de la barra de progreso
            if (docHeight > 0) {
                const scrollPercent = (scrollY / docHeight) * 100;
                if (progressBar) progressBar.style.width = scrollPercent + '%';
            }
        };

        window.addEventListener('scroll', updateUI);
        
        // Lógica de toggle móvil
        document.querySelectorAll('.hs-collapse-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelector(btn.dataset.hsCollapse)?.classList.toggle('hidden');
            });
        });
    });
</script>