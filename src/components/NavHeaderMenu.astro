---
import Link from "@components/ui/LinkMenu.astro";
import stringsNavigation from "@utils/stringsNavigation";
import BrandLogo from "@components/BrandLogo.astro";
import { Icon } from 'astro-icon/components';

const navigation = stringsNavigation;
const homeUrl = "/";
---

<header class="sticky inset-x-0 top-0 z-50 w-full transition-all duration-300 border-b border-transparent [&.scrolled]:border-neutral-800 [&.scrolled]:bg-neutral-950/90 [&.scrolled]:backdrop-blur-xl">
    
    {/* Barra de progreso con efecto neón */}
    <div id="scroll-progress" class="absolute bottom-0 left-0 h-[1px] w-0 bg-amber-500 shadow-[0_0_12px_rgba(245,158,11,0.8)] z-[60]"></div>

    <nav class="relative mx-auto flex max-w-[85rem] items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        
        {/* Lado Izquierdo: Brand */}
        <div class="flex items-center gap-4">
            <a href={homeUrl} class="group outline-none">
                <div class="flex items-center gap-3">
                    <BrandLogo />
                    <div class="hidden lg:block h-8 w-[1px] bg-neutral-800 rotate-12"></div>
                    <span class="hidden lg:block font-display text-[10px] tracking-[0.3em] text-neutral-500 uppercase mt-1">
                        Systems_Core
                    </span>
                </div>
            </a>
        </div>

        {/* Centro: Navegación (Menos redondeada, más técnica) */}
        <div class="hidden md:flex md:items-center md:gap-x-12">
            <div class="flex gap-x-1 bg-neutral-900/50 p-1 border border-neutral-800 rounded-sm">
                {navigation.navBarLinks.map((nav) => (
                    <Link
                        url={nav.url}
                        name={nav.name.toUpperCase()}
                        class="px-4 py-1.5 text-[11px] font-mono tracking-widest text-neutral-400 transition-all hover:text-amber-500"
                        activeClass="bg-amber-500/10 text-amber-500 border-b border-amber-500"
                    />
                ))}
            </div>

            {/* Lado Derecho: Acciones */}
            <div class="flex items-center gap-x-4 border-l border-neutral-800 pl-8">
                <a href="/contacto" class="group relative inline-flex items-center gap-x-2 px-4 py-2 text-[11px] font-mono uppercase tracking-[0.2em] text-amber-500 border border-amber-500/30 hover:bg-amber-500 hover:text-black transition-all">
                    <span>Uplink_Contact</span>
                    <Icon name="mdi:transmission-tower" class="h-4 w-4" />
                </a>
            </div>
        </div>

        {/* Móvil */}
        <div class="flex md:hidden">
            <button type="button" class="hs-collapse-toggle text-amber-500 p-2 border border-neutral-800" data-hs-collapse="#navbar-collapse">
                <Icon name="mdi:menu-open" class="h-6 w-6" />
            </button>
        </div>
    </nav>

    {/* Menú Móvil */}
    <div id="navbar-collapse" class="hidden absolute top-full left-0 w-full bg-neutral-950 border-b border-neutral-800 md:hidden">
        <div class="flex flex-col p-6 gap-y-4">
            {navigation.navBarLinks.map((nav) => (
                <Link url={nav.url} name={nav.name} class="text-sm font-mono tracking-widest uppercase text-neutral-400" activeClass="text-amber-500 border-l-2 border-amber-500 pl-4" />
            ))}
        </div>
    </div>
</header>

<script is:inline>
    // Tu lógica de scroll se mantiene perfecta, solo ajustamos el selector si es necesario
    document.addEventListener('scroll', () => {
        const header = document.querySelector('header');
        const progressBar = document.getElementById('scroll-progress');
        const scrollY = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;

        header?.classList.toggle('scrolled', scrollY > 20);
        if (progressBar && docHeight > 0) {
            progressBar.style.width = (scrollY / docHeight) * 100 + '%';
        }
    });
</script>