---
import Icon from "@components/ui/Icon.astro"
import CustomImage from "@components/ui/CustomImage.astro";
const { icon, title, text, link, svg, image } = Astro.props;
// Importa dinámicamente todas las imágenes
const images = import.meta.glob('../../assets/images/posts/*.{jpg,png,webp}');
// Verifica si la clave de la imagen existe y obtén la URL invocando la función
let imageLocalUrl = null;

if (image?.url) {
    // Obtener solo el nombre del archivo desde image.url
    const imageFileName = image.url.split('/').pop(); // e.g., "how-to-backup-and-restore-postgresql.png"

    // Buscar la ruta en las claves de images
    const imageKey = Object.keys(images).find((key) => key.endsWith(imageFileName));

    if (imageKey) {
        try {
            const module = await images[imageKey](); // Cargar la imagen
            imageLocalUrl = (module as { default: string }).default; // URL de la imagen
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
        }
    } else {
        console.error(`No se encontró la imagen: ${imageFileName}`);
    }
}
---

<div class="flex gap-x-7 py-6 items-start">
	{ icon && <Icon name={ icon } />}
    <div class="flex flex-col lg:flex-row gap-4 w-full">
        <div class="grow">
            <h3 class="font-bold text-neutral-300">
                { title }
            </h3>
            <p class="mt-1 text-sm text-justify text-neutral-400">
                <Fragment
                    set:html = { text }
                />
            </p>
            { link && (
                <a
                    class="group mt-2 inline-flex items-center gap-x-2 rounded-lg text-sm font-medium outline-none transition duration-300  focus-visible:ring text-zinc-400 ring-zinc-200 hover:text-zinc-200 focus:outline-none focus:ring-1"
                    href={ link.href }>
                        { link.text } <Fragment set:html={svg} />
                </a>
            )}
        </div>
        { imageLocalUrl && (
            <div class="shrink-0 flex align-center justify-center w-40 lg:w-96 h-auto ">
                <CustomImage class="object-cover" src={imageLocalUrl} alt={image.alt ?? ''} />
            </div>
        )}
	</div>
</div>