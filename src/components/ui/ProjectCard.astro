---
const { id,title, image, category, tags = [], date, difficulty } = Astro.props;
import { Icon } from "astro-icon/components";
import CustomImage from "@components/ui/CustomImage.astro";

const imagesProjects = import.meta.glob('../../assets/images/projects/*.{jpg,png,webp,avif}');
const getImageProjectUrl = async (imagePath: string) => {
    if (!imagePath) return null;
    const imageFileName = imagePath.split('/').pop() ?? 'default.png';
    const imageKey = Object.keys(imagesProjects).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await imagesProjects[imageKey]();
            return (module as { default: string }).default;
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
            return null;
        }
    }else{
        try {
            const imageDefault = Object.keys(imagesProjects).find((key) => key.endsWith('default.png'));
            if (imageDefault) {
                const module = await imagesProjects[imageDefault]();
                return (module as { default: string }).default;
            }
            return null;
        } catch (e) {
            console.error(`Error cargando la imagen por defecto`, e);
            return null;
        }
    }
    return null;
};
const imageUrl = await getImageProjectUrl(image)
const difficultyColors = {
    Principiante: "bg-green-900/50 text-green-400 border-green-800",
    Intermedio: "bg-amber-900/50 text-amber-400 border-amber-800",
    Avanzado: "bg-red-900/50 text-red-400 border-red-800"
};
---

<article class="group relative overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 hover:border-purple-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/10">
    <!-- Imagen del proyecto -->
    <div class="aspect-[4/3] overflow-hidden">
        <CustomImage
        src={imageUrl}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/70 via-neutral-900/20 to-transparent"></div>
    </div>
    <!-- Contenido -->
    <div class="p-5">
        <!-- Categoría y fecha -->
        <div class="flex justify-between items-center mb-3 text-xs">
        <span class="inline-flex items-center gap-1 text-purple-400">
            <Icon name="mdi:folder" class="h-3.5 w-3.5" />
            {category}
        </span>
        <span class="text-neutral-500">
            {new Date(date).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
        </span>
        </div>
        <!-- Título -->
        <h3 class="text-lg font-bold text-neutral-200 mb-2 group-hover:text-purple-400 transition-colors line-clamp-2">
        {title}
        </h3>
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag:any) => (
            <span class="inline-block px-2 py-1 rounded-full text-xs bg-neutral-800 text-neutral-400">
            {tag}
            </span>
        ))}
        </div>
        <!-- Dificultad -->
        <div class="flex items-center justify-between">
        <span class={`text-xs px-2 py-1 rounded-full border ${difficultyColors[difficulty as keyof typeof difficultyColors] || difficultyColors.Intermedio}`}>
            {difficulty}
        </span>
        <a
            href={`/projects/${category}/${id}`}
            class="text-xs font-medium text-purple-400 hover:text-purple-300 transition-colors flex items-center gap-1"
        >
            Ver detalles
            <Icon name="mdi:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
        </a>
        </div>
    </div>
</article>