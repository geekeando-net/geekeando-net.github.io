---
const { slug, title, image, category, tags = [], pubDate, difficulty } = Astro.props;
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const imagesProjects = import.meta.glob('../../assets/images/projects/*.{jpg,png,webp,avif}');

const getImageProjectUrl = async (projectImage: any) => {
    if (!projectImage) return null;

    // Si ya es un objeto procesado por Astro (vía config.ts)
    if (typeof projectImage === 'object' && projectImage.src) {
        return projectImage;
    }

    // Si es un string, aplicamos la lógica de búsqueda
    if (typeof projectImage === 'string') {
        const imageFileName = projectImage.split('/').pop() ?? 'default.png';
        const imageKey = Object.keys(imagesProjects).find((key) => key.endsWith(imageFileName));
        
        if (imageKey) {
            try {
                const module = await imagesProjects[imageKey]();
                return (module as { default: any }).default;
            } catch (e) { return null; }
        }
    }
    return null;
};

const imageUrl = await getImageProjectUrl(image);

const difficultyColors = {
    Principiante: "border-green-500/30 text-green-500 bg-green-500/5",
    Intermedio: "border-amber-500/30 text-amber-500 bg-amber-500/5",
    Avanzado: "border-red-500/30 text-red-500 bg-red-500/5"
};
---

<article class="group relative overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/30 hover:border-amber-500/30 transition-all duration-500 shadow-2xl">
    <div class="aspect-video overflow-hidden relative">
        {imageUrl ? (
            <Image
                src={imageUrl}
                alt={title}
                width={600}
                height={400}
                class="h-full w-full object-cover transition-all duration-700 grayscale group-hover:grayscale-0 group-hover:scale-105"
            />
        ) : (
            <div class="h-full w-full bg-neutral-800 flex items-center justify-center">
                <Icon name="mdi:image-off" class="h-10 w-10 text-neutral-700" />
            </div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent opacity-80"></div>
    </div>

    <div class="p-5">
        <div class="flex justify-between items-center mb-4 font-mono text-[10px] uppercase tracking-widest text-neutral-500">
            <span class="flex items-center gap-1.5 text-amber-500/70">
                <Icon name="mdi:folder-outline" class="h-3 w-3" />
                {category}
            </span>
            <span>
                {new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </span>
        </div>

        <h3 class="text-lg font-bold text-neutral-200 mb-3 group-hover:text-amber-500 transition-colors italic leading-tight">
            {title}
        </h3>

        <div class="flex flex-wrap gap-1.5 mb-6">
            {tags.map((tag: string) => (
                <span class="px-2 py-0.5 rounded text-[9px] font-mono bg-neutral-800/50 border border-neutral-700 text-neutral-400 group-hover:border-neutral-600 transition-colors">
                    #{tag.toUpperCase()}
                </span>
            ))}
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-neutral-800/50">
            <span class={`text-[9px] font-mono px-2 py-0.5 rounded border ${difficultyColors[difficulty as keyof typeof difficultyColors] || difficultyColors.Intermedio}`}>
                [{difficulty?.toUpperCase()}]
            </span>
            
            <a
                href={`/projects/${category.toLowerCase()}/${slug}`}
                class="text-[10px] font-mono font-bold text-amber-500 hover:text-amber-400 transition-all flex items-center gap-1 group/link"
            >
                OPEN_FILE
                <Icon name="mdi:chevron-right" class="h-3 w-3 transition-transform group-hover/link:translate-x-1" />
            </a>
        </div>
    </div>
</article>