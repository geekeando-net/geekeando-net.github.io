---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Recibimos el objeto completo 'proyecto' de la colección
const { project } = Astro.props;

// Extraemos los datos del esquema definido en config.ts
const {
    title,
    image,
    category,
    tags = [],
    pubDate,
    difficulty
} = project.data;

const slug = project.slug;

const difficultyColors = {
    Principiante: "border-green-500/30 text-green-500 bg-green-500/5",
    Intermedio: "border-amber-500/30 text-amber-500 bg-amber-500/5",
    Avanzado: "border-red-500/30 text-red-500 bg-red-500/5"
};
---

<article class="group relative overflow-hidden border border-neutral-800 bg-neutral-950 transition-all duration-500 hover:border-amber-500/40 shadow-2xl">

    <div class="absolute top-0 left-0 z-20 bg-neutral-800 px-2 py-0.5 text-[8px] font-mono text-neutral-500 uppercase tracking-tighter border-br border-neutral-700">
        Record_{slug.substring(0,6)}
    </div>

    <div class="aspect-video overflow-hidden relative border-b border-neutral-900 bg-black">
        {image ? (
            <Image
                src={image}
                alt={title}
                width={600}
                height={400}
                class="h-full w-full object-cover transition-all duration-1000 grayscale group-hover:grayscale-0 group-hover:scale-110 opacity-60 group-hover:opacity-100"
            />
        ) : (
            <div class="h-full w-full bg-neutral-900 flex items-center justify-center">
                <Icon name="mdi:image-off" class="h-10 w-10 text-neutral-800" />
            </div>
        )}
        
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent opacity-90"></div>
    </div>

    <div class="p-6">
        <div class="flex justify-between items-center mb-4 font-mono text-[9px] uppercase tracking-[0.2em] text-neutral-600">
            <span class="flex items-center gap-1.5 text-amber-500/60 group-hover:text-amber-500 transition-colors">
                <Icon name="mdi:folder-zip-outline" class="h-3 w-3" />
                {category}
            </span>
            <span>
                {new Date(pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
            </span>
        </div>

        <h3 class="text-lg font-bold text-neutral-200 mb-4 group-hover:text-white transition-colors italic leading-tight uppercase tracking-tight">
            {title}
        </h3>

        <div class="flex flex-wrap gap-1.5 mb-6 text-neutral-500 min-h-[20px]">
            {tags.map((tag: string) => (
                <span class="px-2 py-0.5 text-[9px] font-mono bg-neutral-900 border border-neutral-800 text-neutral-500 group-hover:text-amber-500/70 transition-all">
                    #{tag.replace(/\s+/g, '_').toUpperCase()}
                </span>
            ))}
        </div>

        <div class="flex items-center justify-between pt-5 border-t border-neutral-900">
            <div class="flex flex-col">
                <span class="text-[7px] text-neutral-700 uppercase font-mono mb-1">Status_Check</span>
                <span class={`text-[9px] font-mono px-2 py-0.5 border ${difficultyColors[difficulty as keyof typeof difficultyColors] || difficultyColors.Intermedio}`}>
                    {difficulty?.toUpperCase()}
                </span>
            </div>

            <a
                href={`/projects/${category.toLowerCase()}/${slug}`}
                class="bg-amber-500/10 hover:bg-amber-500 px-4 py-2 text-[10px] font-mono font-black text-amber-500 hover:text-black transition-all duration-300 flex items-center gap-2 border border-amber-500/20"
            >
                ACCESS_DATA
                <Icon name="mdi:arrow-right" class="h-3 w-3" />
            </a>
        </div>
    </div>
</article>