---
const { projects, currentCategory } = Astro.props;
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

// 1. Cargamos las imágenes
const imagesProjects = import.meta.glob('../../../assets/images/projects/*.{jpg,png,webp,avif}');

const getImageProjectUrl = async (imagePath: any) => {
    if (!imagePath) return null;
    // Si ya es un objeto de imagen de Astro (vía config.ts), lo devolvemos directamente
    if (typeof imagePath === 'object' && imagePath.src) {
        return imagePath;
    }
    const imageFileName = imagePath.split('/').pop() ?? 'default.png';
    const imageKey = Object.keys(imagesProjects).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await imagesProjects[imageKey]();
            return (module as { default: any }).default;
        } catch (e) { return null; }
    }
    return null;
};

// 2. Resolvemos las URLs antes de renderizar
const imageProjetsUrls = await Promise.all(
    projects.map((project: any) => getImageProjectUrl(project.data.image))
);
---

{projects.length > 0 && (
  <section>
      {projects.map((project: any, index: number) => (
        <a
          href={`/projects/${currentCategory.toLowerCase()}/${project.slug}`}
          class="group block bg-neutral-900/40 border border-neutral-800 rounded-xl overflow-hidden hover:border-amber-500/30 transition-all duration-500"
          data-astro-prefetch
        >
          <div class="aspect-video overflow-hidden relative bg-neutral-950">
            {imageProjetsUrls[index] ? (
              <Image
                src={imageProjetsUrls[index]}
                alt={project.data.title}
                width={400}
                height={225}
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
              />
            ) : (
                <div class="w-full h-full flex items-center justify-center text-neutral-800">
                    <Icon name="mdi:image-off-outline" class="h-10 w-10" />
                </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent opacity-80"></div>
          </div>

          <div class="p-4">
            <h3 class="text-sm font-bold text-neutral-200 group-hover:text-amber-500 transition-colors line-clamp-1 italic">
              {project.data.title || "Untitled Project"}
            </h3>
            
            <div class="mt-4 flex items-center justify-between text-[9px] font-mono text-neutral-600">
               <span class="flex items-center gap-1 uppercase">
                 <Icon name="mdi:clock-outline" class="h-3 w-3" /> 
                 EST_TIME: 2-4H
               </span>
               <span class="text-amber-500/50 group-hover:text-amber-500">READ_FILE</span>
            </div>
          </div>
        </a>
      ))}
  </section>
)}