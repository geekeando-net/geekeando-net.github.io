---
// Recibe un solo objeto de proyecto y la categoría
const { project, currentCategory } = Astro.props;
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

// Extraemos los datos del proyecto único
const { title, image, difficulty } = project.data;
const slug = project.slug;
---

<a
  href={`/projects/${currentCategory.toLowerCase()}/${slug}`}
  class="group block bg-neutral-900/20 border border-neutral-800 overflow-hidden hover:border-amber-500/40 transition-all duration-500 relative"
  data-astro-prefetch
>
  <div class="absolute top-0 right-0 z-10 bg-neutral-900 px-1.5 py-0.5 text-[7px] font-mono text-neutral-600 border-l border-b border-neutral-800">
    REL_{slug.substring(0,6).toUpperCase()}
  </div>

  <div class="aspect-video overflow-hidden relative bg-black">
    {image ? (
      <Image
        src={image}
        alt={title}
        width={400}
        height={225}
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110 opacity-60 group-hover:opacity-100"
      />
    ) : (
        <div class="w-full h-full flex items-center justify-center text-neutral-900">
            <Icon name="mdi:image-off-outline" class="h-8 w-8" />
        </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent opacity-90 border-b border-neutral-900"></div>
  </div>

  <div class="p-4">
    <h3 class="text-[11px] font-black text-neutral-400 group-hover:text-amber-500 transition-colors line-clamp-1 uppercase tracking-tight italic">
      {title || "Untitled Project"}
    </h3>
    
    <div class="mt-3 flex items-center justify-between text-[8px] font-mono">
       <span class="flex items-center gap-1 text-neutral-600 uppercase tracking-tighter">
         <Icon name="mdi:label-outline" class="h-3 w-3 text-amber-500/50" /> 
         {difficulty || 'N/A'}
       </span>
       <span class="text-amber-500/40 group-hover:text-amber-500 transition-colors uppercase">
         Fetch_Data >>
       </span>
    </div>
  </div>
</a>