---
import { Image } from 'astro:assets';
// Eliminamos toda la lógica de getImageProjectUrl y import.meta.glob

interface Props {
  number: number;
  title: string;
  content: string;
  image?: any; // Ahora Astro nos pasa el objeto de imagen directamente
  code?: string;
  isLast?: boolean;
}

const { number, title, content, image, code, isLast } = Astro.props;
---

<div class="flex gap-6 group">
    <div class="flex flex-col items-center">
        <div class="flex items-center justify-center h-10 w-10 rounded-full bg-neutral-900 border-2 border-amber-500/30 text-amber-500 font-mono font-bold text-sm">
            {number.toString().padStart(2, '0')}
        </div>
        {!isLast && <div class="w-px h-full bg-gradient-to-b from-amber-500/30 to-transparent my-2"></div>}
    </div>
    
    <div class="flex-1 pb-12">
        <h3 class="text-lg font-mono font-bold text-neutral-100 uppercase tracking-tighter mb-4 italic">
            <span class="text-amber-500/50">>>></span> {title}
        </h3>
        
        <div class="space-y-4">
            <p class="text-sm text-neutral-400 leading-relaxed font-sans">
                {content}
            </p>
            
            {image && (
                <div class="rounded-xl overflow-hidden border border-neutral-800 bg-neutral-950">
                    <Image 
                        src={image} 
                        alt={title} 
                        width={800}
                        class="w-full grayscale hover:grayscale-0 transition-all duration-700"
                    />
                </div>
            )}
            
            {code && (
                <div class="relative group/code mt-6">
                    <div class="absolute -top-3 left-4 px-2 py-0.5 bg-neutral-900 border border-neutral-800 text-[9px] font-mono text-neutral-500 rounded uppercase z-10">
                        Snippet_Step_{number}.ino
                    </div>
                    
                    <button 
                        class="copy-btn absolute -top-3 right-3 px-2 py-1 bg-amber-500/10 border border-amber-500/20 rounded text-[9px] font-mono text-amber-500 hover:bg-amber-500 hover:text-black transition-all z-10"
                        data-code={code}
                    >
                        COPY_CODE
                    </button>
            
                    <pre class="bg-neutral-950 rounded-lg border border-neutral-800 p-5 text-xs text-amber-400/90 font-mono overflow-x-auto relative"><code>{code.trim()}</code>
                    </pre>
                </div>
            )}
        </div>
    </div>
</div>
<script>
    const copyButtons = document.querySelectorAll('.copy-btn');

    copyButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const code = btn.getAttribute('data-code');
            if (code) {
                navigator.clipboard.writeText(code).then(() => {
                    const originalText = btn.textContent;
                    btn.textContent = 'COPIED_OK!';
                    btn.classList.add('bg-green-500/20', 'text-green-500', 'border-green-500/50');
                    
                    setTimeout(() => {
                        btn.textContent = originalText;
                        btn.classList.remove('bg-green-500/20', 'text-green-500', 'border-green-500/50');
                    }, 2000);
                });
            }
        });
    });
</script>