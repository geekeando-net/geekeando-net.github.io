---
const { items, category } = Astro.props;
import { Icon } from 'astro-icon/components';

const categoryIcons = {
    Arduino: "mdi:chip",
    "Paper Craft": "mdi:paper-cut-vertical",
    "3D Print": "mdi:printer-3d",
    Music: "mdi:music"
};
---
<div class="space-y-4">
  <div class="flex items-center gap-2 text-amber-500 mb-4">
    <Icon name="mdi:tools" class="h-5 w-5" />
    <span class="text-xs font-mono uppercase tracking-widest">Materiales necesarios</span>
  </div>
  
  <ul class="space-y-2">
    {items.map((item:any) => (
      <li class="group flex items-center justify-between p-3 rounded-lg border border-neutral-800 bg-neutral-900/50 hover:border-amber-500/30 transition-all">
        <div class="flex items-center gap-3">
            <div class="p-2 rounded bg-neutral-800 text-neutral-500 group-hover:text-amber-500 transition-colors">
                <Icon name="mdi:package-variant-closed" class="h-4 w-4" />
            </div>
            <span class="text-sm text-neutral-300 font-medium">{item.name}</span>
        </div>
        <span class="text-xs font-mono font-bold text-amber-500 bg-amber-500/10 px-2 py-1 rounded">
          x{item.quantity}
        </span>
      </li>
    ))}
  </ul>
</div>

