---
const { items, category } = Astro.props;
import { Icon } from 'astro-icon/components';

const categoryIcons = {
    Arduino: "mdi:chip",
    "Paper Craft": "mdi:paper-cut-vertical",
    "3D Print": "mdi:printer-3d",
    Music: "mdi:music"
};
---

<div class="rounded-xl border border-neutral-800 bg-neutral-900/50 p-6">
  <h3 class="text-xl font-bold text-neutral-200 mb-4 flex items-center gap-2">
    <Icon name={categoryIcons[category as keyof typeof categoryIcons] || "mdi:tools"} class="h-5 w-5 text-purple-400" />
    Materiales necesarios
  </h3>
  
  <div class="space-y-3">
    {items.map((item: { name: string, quantity: number, link: string }) => (
      <div class="flex items-center justify-between rounded-lg border border-neutral-800 px-4 py-3 hover:bg-neutral-800/50 transition-colors">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center h-8 w-8 rounded-md bg-purple-500/10 text-purple-400">
            <Icon name="mdi:checkbox-blank-outline" class="h-4 w-4" />
          </div>
          <div>
            <p class="font-medium text-neutral-200">{item.name}</p>
            {item.quantity > 1 && (
              <p class="text-xs text-neutral-500">Cantidad: {item.quantity}</p>
            )}
          </div>
        </div>
        {item.link && (
          <a 
            href={item.link} 
            class="text-purple-400 hover:text-purple-300 transition-colors"
            title="Donde comprar"
          >
            <Icon name="mdi:shopping" class="h-5 w-5" />
          </a>
        )}
      </div>
    ))}
  </div>

  {/* Nota adicional */}
  <div class="mt-4 flex items-start gap-2 rounded-lg bg-neutral-800/50 p-3 text-sm text-neutral-400 border border-neutral-700">
    <Icon name="mdi:information" class="h-5 w-5 flex-shrink-0 text-blue-400" />
    <p>Los enlaces de compra son sugerencias. Puedes encontrar estos componentes en tu tienda de electrónica local o diferentes proveedores online.</p>
  </div>
</div>