---
import { Icon } from 'astro-icon/components';
const { files } = Astro.props;

const fileIcons = {
    PDF: "mdi:file-pdf",
    ZIP: "mdi:folder-zip",
    STL: "mdi:cube-outline",
    INO: "mdi:file-code-outline",
    F3D: "mdi:cube-scan",
    SVG: "mdi:vector-curve"
};
---

<div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-5">
  <h3 class="text-xs font-mono text-amber-500 mb-6 flex items-center gap-2 uppercase tracking-[0.2em]">
    <Icon name="mdi:download-network-outline" class="h-4 w-4 animate-bounce" />
    Recursos [.root]
  </h3>
  
  <div class="space-y-2">
    {files.map((file: { link: string, type: string, name: string, size?: string }) => (
      <a
        href={file.link}
        target={file.type === 'INO' ? "_blank" : "_self"}
        download={file.type !== 'INO'}
        class="group flex items-center justify-between rounded border border-neutral-800/50 px-4 py-3 hover:border-amber-500/40 hover:bg-amber-500/5 transition-all duration-300"
      >
        <div class="flex items-center gap-3">
          <div class="text-neutral-500 group-hover:text-amber-500 transition-colors">
            <Icon name={fileIcons[file.type as keyof typeof fileIcons] || "mdi:file-outline"} class="h-5 w-5" />
          </div>
          <div>
            <p class="text-xs font-mono text-neutral-300 group-hover:text-neutral-100 transition-colors">
              {file.name}
            </p>
            <p class="text-[9px] font-mono text-neutral-600 uppercase">
              {file.type} {file.size ? `• ${file.size}` : '• CLOUD_LINK'}
            </p>
          </div>
        </div>
        <Icon 
          name="mdi:chevron-right" 
          class="h-4 w-4 text-neutral-700 group-hover:text-amber-500 transition-transform group-hover:translate-x-1" 
        />
      </a>
    ))}
  </div>

  <div class="mt-6 pt-4 border-t border-neutral-800/50">
    <p class="text-[9px] font-mono text-neutral-600 flex items-center justify-center gap-2 italic">
      <Icon name="mdi:shield-check-outline" class="h-3 w-3" />
      LICENCIA_CC_BY-NC-SA_2025
    </p>
  </div>
</div>