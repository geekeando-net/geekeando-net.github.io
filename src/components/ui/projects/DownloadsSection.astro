---
import { Icon } from 'astro-icon/components';
const { files } = Astro.props;

/**
 * Mapeo extendido de iconos para el laboratorio
 * Añadimos tipos comunes en Arduino y Papercraft
 */
const fileIcons: Record<string, string> = {
    PDF: "mdi:file-pdf-box",
    ZIP: "mdi:folder-zip-outline",
    STL: "mdi:printer-3d-nozzle",
    INO: "mdi:chip",
    F3D: "mdi:cube-scan",
    SVG: "mdi:vector-bezier",
    GIT: "mdi:github",
    DOC: "mdi:file-document-outline"
};
---

<div class="rounded-xl border border-neutral-800 bg-black/40 p-6">
  <div class="flex items-center justify-between mb-6">
    <h3 class="text-[10px] font-mono text-amber-500 uppercase tracking-[0.3em] flex items-center gap-2">
      <Icon name="mdi:download-network-outline" class="h-4 w-4" />
      Data_Vault [.root]
    </h3>
    <span class="text-[8px] font-mono text-neutral-700 animate-pulse">SISTEMA_OK</span>
  </div>
  
  <div class="space-y-3">
    {files.map((file: { link: string, type: string, name: string, size?: string }) => {
      // Lógica para detectar si es link externo o archivo local
      const isExternal = file.link.startsWith('http') || file.type === 'GIT';
      
      return (
        <a
          href={file.link}
          target={isExternal ? "_blank" : "_self"}
          download={!isExternal}
          class="group flex items-center justify-between border border-neutral-800/80 p-4 hover:border-amber-500/30 hover:bg-amber-500/5 transition-all duration-300 relative overflow-hidden"
        >
          {/* Decoración de fondo estilo 'Active' */}
          <div class="absolute left-0 top-0 w-0.5 h-0 group-hover:h-full bg-amber-500 transition-all duration-300"></div>

          <div class="flex items-center gap-4">
            <div class="p-2 bg-neutral-900 border border-neutral-800 text-neutral-600 group-hover:text-amber-500 group-hover:border-amber-500/30 transition-all">
              <Icon name={fileIcons[file.type.toUpperCase()] || "mdi:file-outline"} class="h-5 w-5" />
            </div>
            <div>
              <p class="text-[11px] font-bold font-mono text-neutral-400 group-hover:text-white transition-colors uppercase tracking-tighter">
                {file.name}
              </p>
              <p class="text-[8px] font-mono text-neutral-600 flex items-center gap-2">
                <span class="text-amber-500/40">[{file.type}]</span> 
                {file.size ? `• ${file.size}` : isExternal ? '• REMOTE_REPO' : '• LOCAL_BUNDLE'}
              </p>
            </div>
          </div>
          
          <div class="flex items-center">
             <Icon 
              name={isExternal ? "mdi:open-in-new" : "mdi:download"} 
              class="h-4 w-4 text-neutral-800 group-hover:text-amber-500 transition-all" 
            />
          </div>
        </a>
      )
    })}
  </div>

  <div class="mt-8 pt-4 border-t border-neutral-900 flex justify-between items-center">
    <p class="text-[8px] font-mono text-neutral-700 flex items-center gap-2 italic">
      <Icon name="mdi:shield-check-outline" class="h-3 w-3" />
      CC BY-NC-SA 4.0
    </p>
    <div class="flex gap-1">
        <div class="w-1 h-1 bg-amber-500/20"></div>
        <div class="w-1 h-1 bg-amber-500/40"></div>
        <div class="w-1 h-1 bg-amber-500/60"></div>
    </div>
  </div>
</div>