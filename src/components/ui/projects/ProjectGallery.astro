---
import CustomImage from "@components/ui/CustomImage.astro";
const { images } = Astro.props;

const imagesProjects = import.meta.glob('../../../assets/images/projects/*.{jpg,png,webp,avif}');
const getImageProjectUrl = async (imagePath: string) => {
    if (!imagePath) return null;
    const imageFileName = imagePath.split('/').pop() ?? 'default.png';
    const imageKey = Object.keys(imagesProjects).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await imagesProjects[imageKey]();
            return (module as { default: string }).default;
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
            return null;
        }
    }else{
        try {
            const imageDefault = Object.keys(imagesProjects).find((key) => key.endsWith('default.png'));
            if (imageDefault) {
                const module = await imagesProjects[imageDefault]();
                return (module as { default: string }).default;
            }
            return null;
        } catch (e) {
            console.error(`Error cargando la imagen por defecto`, e);
            return null;
        }
    }

    return null;
};
const imageGalleryUrl = await getImageProjectUrl(images[0].src ?? '');

---

<div class="space-y-4">
    <!-- Imagen principal -->
    <div class="rounded-xl overflow-hidden border border-neutral-800 bg-neutral-900">
        <CustomImage
            src={imageGalleryUrl}
            alt={images[0].alt}
            class="w-full h-auto max-h-[500px] object-cover"
            id="main-gallery-image"
            loading="eager"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 33vw"
            format="webp"
        />
    </div>

    <!-- Miniaturas -->
    {images.length > 1 && (
        <div class="grid grid-cols-4 gap-3">
        {images.map((image: any, index: number) => (
            <button
            onclick={`document.getElementById('main-gallery-image').src = '${image.src}'; document.getElementById('main-gallery-image').alt = '${image.alt}';`}
            class={`aspect-square rounded-lg overflow-hidden border ${index === 0 ? 'border-purple-500/50' : 'border-neutral-800'} hover:border-purple-400 transition-colors`}
            >
            <CustomImage
                src={getImageProjectUrl(image.src)}
                alt={image.alt}
                class="h-full w-full object-cover"
                loading="lazy"
            />
            </button>
        ))}
        </div>
    )}

    <!-- Indicador de cantidad -->
    <p class="text-sm text-neutral-500 text-center">
        {images.length} {images.length === 1 ? 'imagen' : 'imágenes'} disponible{images.length === 1 ? '' : 's'}
    </p>
</div>

<style is:global>
    /* Efecto hover para las miniaturas */
    .grid.grid-cols-4 button:hover img {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }
</style>