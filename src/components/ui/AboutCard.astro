---
import { Icon } from "astro-icon/components";

const {
    icon = '📌',
    title,
    text1,
    text2,
    text3,
    link,
    svg,
    cardClass = '',
    accentColor = 'amber'
} = Astro.props as {
    icon?: string;
    title: string;
    text1?: string;
    text2?: string;
    text3?: string;
    link?: { href: string; text: string };
    svg?: string;
    cardClass?: string;
    accentColor?: keyof typeof colorVariants;
};

const colorVariants = {
    amber: 'border-amber-500/30 group-hover:border-amber-500 text-amber-500',
    purple: 'border-purple-500/30 group-hover:border-purple-500 text-purple-500',
    blue: 'border-blue-500/30 group-hover:border-blue-500 text-blue-500',
    green: 'border-emerald-500/30 group-hover:border-emerald-500 text-emerald-500'
};

const bgVariants = {
    amber: 'bg-amber-500/5',
    purple: 'bg-purple-500/5',
    blue: 'bg-blue-500/5',
    green: 'bg-emerald-500/5'
};
---

<div class={`group relative flex flex-col border bg-neutral-950 p-6 transition-all duration-500 ${colorVariants[accentColor]} ${cardClass}`}>
    
    <div class="absolute top-0 right-0 p-1 text-[8px] font-mono text-neutral-800 uppercase select-none">
        Ref_ID: {Math.random().toString(36).substring(7).toUpperCase()}
    </div>
    <div class="absolute bottom-0 left-0 p-1 text-[8px] font-mono text-neutral-800 uppercase select-none">
        Coord: 40.7128° N
    </div>

    <div class="flex items-start justify-between mb-6">
        {icon && (
            <div class={`flex h-12 w-12 items-center justify-center border-2 bg-neutral-900 transition-all duration-500 group-hover:rotate-12 ${colorVariants[accentColor]}`}>
                {icon.startsWith('mdi:') ? (
                    <Icon name={icon} class="h-6 w-6" />
                ) : (
                    <span class="text-2xl">{icon}</span>
                )}
            </div>
        )}
        <div class={`h-[2px] w-12 mt-6 bg-neutral-900 relative after:content-[''] after:absolute after:right-0 after:-top-1 after:h-2 after:w-2 after:rounded-full after:bg-current transition-colors ${colorVariants[accentColor]}`}></div>
    </div>

    <div class="flex-grow space-y-4">
        <h3 class="text-lg font-black uppercase tracking-tighter text-white font-mono italic">
            <span class={`text-xs not-italic mr-1 opacity-50 ${colorVariants[accentColor]}`}>//</span>
            {title}
        </h3>

        <div class="space-y-3 font-sans border-l-2 border-neutral-900 pl-4 group-hover:border-current transition-colors">
            {text1 && (
                <p class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors leading-relaxed">
                    <Fragment set:html={text1} />
                </p>
            )}
            {text2 && (
                <p class="text-xs text-neutral-500 italic">
                    <Fragment set:html={text2} />
                </p>
            )}
            {text3 && (
                <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-widest">
                    <Fragment set:html={text3} />
                </p>
            )}
        </div>
    </div>

    {link && (
        <div class="mt-8">
            <a
                href={link.href}
                class={`relative overflow-hidden inline-flex items-center gap-x-2 px-4 py-2 border font-mono text-[10px] font-bold uppercase tracking-[0.2em] transition-all duration-300 ${colorVariants[accentColor]} group-hover:bg-current group-hover:text-black`}
            >
                <span class="relative z-10">{link.text}</span>
                {svg ? (
                    <Fragment set:html={svg} />
                ) : (
                    <Icon name="mdi:chevron-right" class="h-4 w-4 relative z-10 group-hover:translate-x-1 transition-transform" />
                )}
            </a>
        </div>
        )}
    </div>
</div>

<style>
    /* Efecto de fondo de rejilla sutil al hacer hover */
    .group:hover {
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
        background-size: 24px 24px;
        transform: translateY(-4px);
    }
</style>