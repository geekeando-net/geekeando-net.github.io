---
import { Icons } from '@utils/icons';

interface Path {
    d: string;
    class?: string;
}

interface IconData {
    paths: Path[];
    class?: string;
    height?: string | number;
    viewBox?: string;
    width?: string | number;
    fill?: string;
    clipRule?: string;
    fillRule?: string;
    stroke?: string;
    strokeWidth?: string | number;
    strokeLinecap?: "round" | "butt" | "square" | "inherit";
    strokeLinejoin?: "round" | "bevel" | "miter" | "inherit";
    title?: string;
}

const { name, class: customClass = "" } = Astro.props;

// Buscamos el icono en el objeto utilitario
let icon = (Icons as any)[name] as IconData;

// Si no existe, devolvemos null para el renderizado condicional
let paths: Path[] = icon?.paths || [];
---

{
    icon ? (
        <svg
            class={`inline-block transition-all duration-300 ${icon.class || ""} ${customClass}`}
            height={icon.height || "24"}
            width={icon.width || "24"}
            viewBox={icon.viewBox || "0 0 24 24"}
            fill={icon.fill || "currentColor"}
            stroke={icon.stroke || "none"}
            stroke-width={icon.strokeWidth}
            stroke-linecap={icon.strokeLinecap}
            stroke-linejoin={icon.strokeLinejoin}
            role="img"
            aria-hidden="true"
        >
            {icon.title && <title>{icon.title}</title>}
            {
                paths.map((path: Path) => (
                    <path 
                        d={path.d} 
                        class={`transition-all duration-500 ${path.class || ""}`}
                    />
                ))
            }
        </svg>
    ) : (
        <span class="text-[10px] font-mono text-red-500 border border-red-500/20 px-1 uppercase">
            Err: Icon_Null
        </span>
    )
}

<style is:global>
    /* Efecto "Power-On" para iconos en hover */
    .group:hover svg.icon-power {
        filter: drop-shadow(0 0 5px currentColor);
        transform: scale(1.1);
    }

    /* Animación de pulso para iconos de estado */
    .icon-status-pulse {
        animation: icon-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes icon-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.95); }
    }
</style>