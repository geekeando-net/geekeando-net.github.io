---
// Props del componente
import CustomImage from "@components/ui/CustomImage.astro";
const { title, text, link, svg, image, tags, pubDate, author } = Astro.props;
const images = import.meta.glob('../../../assets/images/posts/*.{jpg,png,webp,avif}');
let imageLocalUrl = null;

if (image?.url) {
    const imageFileName = image.url.split('/').pop(); // e.g., "how-to-backup-and-restore-postgresql.png"
    const imageKey = Object.keys(images).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await images[imageKey](); // Cargar la imagen
            imageLocalUrl = (module as { default: string }).default; // URL de la imagen
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
        }
    }
}
---

<article class="group h-full flex flex-col overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 hover:border-amber-400/30 transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/10">
    <!-- Imagen -->
    { imageLocalUrl && (
        <div class="lg:w-1/3 overflow-hidden rounded-lg border border-neutral-800 shadow-lg shadow-neutral-950/50">
            <CustomImage
                src={imageLocalUrl}
                alt={`Portada para ${image.alt || title}`}
                class="w-full lg:h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                widths={[400, 600, 800]}
                sizes="(max-width: 1024px) 100vw, 33vw"
                format="webp"
            />
        </div>
        )}
    <!-- Contenido -->
    <div class="flex-grow p-6 flex flex-col">
        <!-- Categoría y fecha -->
        <div class="flex justify-between items-center mb-3">
            { tags.map ((tag: string) => (
                <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-amber-500/10 text-amber-400">
                    <a href={`/tags/${tag}`} class="no-underline text-amber-400 hover:text-amber-300 transition-colors">
                        {tag}
                    </a>
                </span>
            ))}
            <span class="text-xs text-neutral-500">{pubDate}</span>
        </div>

        <!-- Título -->
        <h3 class="text-xl font-bold text-neutral-100 mb-2 group-hover:text-amber-400 transition-colors line-clamp-2">
            <a href={link.href}>{title}</a>
        </h3>

        <!-- Descripción -->
        <p class="text-neutral-400 mb-4 line-clamp-3 flex-grow">
            <Fragment
                    set:html = { text }
            />
        </p>

        <!-- Metadata inferior -->
        <div class="mt-auto pt-4 border-t border-neutral-800">
            <div class="flex justify-between items-center text-sm">
                <span class="text-xs text-neutral-500">{new Date(pubDate).toLocaleDateString('es-LA', { year: 'numeric', month: 'numeric', day: 'numeric' })}</span>
                <span class="text-xs text-neutral-500">{author}</span>
                <a href={link.href}class="flex items-center text-amber-400 hover:text-amber-300 transition-colors font-medium">
                    Leer más <Fragment set:html={svg} />
                </a>
            </div>
        </div>
    </div>
</article>