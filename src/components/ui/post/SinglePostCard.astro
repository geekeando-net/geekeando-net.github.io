---
// Props del componente
const { title, text, link, svg, image, tags, pubDate, author } = Astro.props;
const images = import.meta.glob('../../../assets/images/posts/*.{jpg,png,webp,avif}');
let imageLocalUrl = null;

if (image?.url) {
    const imageFileName = image.url.split('/').pop();
    const imageKey = Object.keys(images).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await images[imageKey]();
            imageLocalUrl = (module as { default: any }).default;
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
        }
    }
}
---

<article class="group relative flex flex-col h-full bg-neutral-900/20 border border-neutral-800 rounded-xl overflow-hidden hover:bg-neutral-900/40 hover:border-amber-500/40 transition-all duration-300">
    
    {/* Contenedor de Imagen con Efecto Técnico */}
    {imageLocalUrl && (
        <div class="relative aspect-video overflow-hidden border-b border-neutral-800">
            <div class="absolute inset-0 z-10 bg-neutral-950/20 group-hover:bg-transparent transition-colors"></div>
            <img
                src={imageLocalUrl.src}
                alt={image.alt || title}
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                loading="lazy"
            />
            {/* Badge de "Log" sobre la imagen */}
            <div class="absolute bottom-2 left-2 z-20">
                <span class="text-[8px] font-mono bg-neutral-950/80 text-amber-500 px-2 py-0.5 border border-amber-500/20 backdrop-blur-sm">
                    ENTRY_ID: {Math.random().toString(36).substring(7).toUpperCase()}
                </span>
            </div>
        </div>
    )}

    <div class="p-6 flex flex-col flex-grow">
        {/* Tags Estilo CLI */}
        <div class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="text-[9px] font-mono text-amber-500/60 hover:text-amber-500 transition-colors uppercase tracking-widest">
                    #{tag}
                </a>
            ))}
        </div>

        {/* Título - Fuente Display */}
        <h3 class="text-lg font-display font-bold text-neutral-100 mb-3 group-hover:text-amber-500 transition-colors line-clamp-2 uppercase tracking-tight leading-tight">
            <a href={link.href}>{title}</a>
        </h3>

        {/* Descripción - Fuente Sans Light */}
        <p class="text-sm text-neutral-500 font-light mb-6 line-clamp-3 leading-relaxed">
            <Fragment set:html={text} />
        </p>

        {/* Metadata Inferior */}
        <div class="mt-auto pt-4 border-t border-neutral-800/50">
            <div class="flex justify-between items-center text-[10px] font-mono text-neutral-600">
                <div class="flex flex-col">
                    <span>DATE: {new Date(pubDate).toLocaleDateString('es-ES', { year: '2-digit', month: '2-digit', day: '2-digit' })}</span>
                    <span>AUTH: {author?.toUpperCase() || 'PEDRO_C'}</span>
                </div>
                <a href={link.href} class="flex items-center gap-1 text-amber-500 hover:text-amber-400 transition-all group-hover:translate-x-1">
                    {link.text.toUpperCase()} <Fragment set:html={svg} />
                </a>
            </div>
        </div>
    </div>
    
    {/* La barra de carga (buffer) que definimos antes */}
    <div class="buffer-bar"></div>
</article>

<style>
    .font-display { font-family: 'Orbitron', sans-serif; }
    
    .buffer-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        width: 0;
        background: #f59e0b;
        transition: width 0.5s ease;
        box-shadow: 0 0 10px #f59e0b;
    }

    article:hover .buffer-bar {
        width: 100%;
    }
</style>