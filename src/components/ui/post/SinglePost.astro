---
const { title, text, link, svg, image, tags, pubDate, author } = Astro.props;
const images = import.meta.glob('../../../assets/images/posts/*.{jpg,png,webp,avif}');
let imageLocalUrl = null;

if (image?.url) {
    const imageFileName = image.url.split('/').pop();
    const imageKey = Object.keys(images).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await images[imageKey]();
            imageLocalUrl = (module as { default: any }).default;
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
        }
    }
}

// Cálculo de días transcurridos
const daysAgo = Math.floor((new Date().getTime() - new Date(pubDate).getTime()) / (1000 * 60 * 60 * 24));
---

<article class="group py-8 border-b border-neutral-900/50 last:border-0 hover:bg-neutral-900/20 transition-all duration-300 px-4 rounded-xl">
    <div class="flex flex-col lg:flex-row gap-8 w-full">
        
        { imageLocalUrl && (
            <div class="lg:w-1/3 relative overflow-hidden rounded-lg border border-neutral-800 shadow-2xl">
                <div class="absolute inset-0 z-10 bg-neutral-950/20 group-hover:bg-transparent transition-colors"></div>
                <img
                    src={imageLocalUrl?.src}
                    alt={image.alt || title}
                    class="w-full h-48 lg:h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105" 
                    loading="lazy"
                />
                <div class="absolute top-2 right-2 z-20">
                     <span class="text-[8px] font-mono bg-neutral-950/90 text-amber-500 px-2 py-1 border border-amber-500/20 backdrop-blur-sm">
                        IMG_SRC::LOCAL
                    </span>
                </div>
            </div>
        )}

        <div class={`space-y-4 ${imageLocalUrl ? 'lg:w-2/3' : 'w-full'}`}>
            <div class="flex flex-wrap gap-2">
                { tags.map ((tag: string) => (
                    <a href={`/tags/${tag}`} class="text-[10px] font-mono text-amber-500/70 hover:text-amber-400 border border-amber-500/10 bg-amber-500/5 px-2 py-0.5 transition-all">
                        #{tag.toUpperCase()}
                    </a>
                ))}
            </div>

            <h3 class="text-2xl font-display font-bold text-white group-hover:text-amber-500 transition-colors tracking-tight uppercase">
                <a href={link.href}>{ title }</a>
            </h3>

            <div class="text-sm text-neutral-400 font-light line-clamp-3 leading-relaxed max-w-2xl">
                <Fragment set:html={text} />
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4">
                { link && (
                    <a
                        href={link.href}
                        class="inline-flex items-center gap-x-2 text-[11px] font-mono font-bold text-amber-500 hover:text-amber-400 transition-all group-hover:translate-x-1"
                    >
                        [ {link.text.toUpperCase()} ]
                        <Fragment set:html={svg} />
                    </a>
                )}

                <div class="flex items-center gap-4 text-[10px] font-mono text-neutral-600 border-l border-neutral-800 pl-4">
                    <div class="flex flex-col">
                        <span class="uppercase">Status: {daysAgo === 0 ? 'Recently_Updated' : `Logged_${daysAgo}_Days_Ago`}</span>
                        <span class="uppercase">Auth: {author}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>

<style>
    .font-display { font-family: 'Orbitron', sans-serif; }
</style>