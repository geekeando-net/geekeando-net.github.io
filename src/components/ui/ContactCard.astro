---
import { Icon } from 'astro-icon/components';
interface ContactCardProps {
    icon: string;
    title: string;
    items: string[];
    link?: { href: string; text: string };
}

const { icon, title, items = [], link } = Astro.props as ContactCardProps;
---

<div class="group relative rounded-xl border border-neutral-800 bg-neutral-900/30 p-6 transition-all duration-300 hover:border-amber-500/50 hover:bg-neutral-900/50">
    
    {/* Decoración: ID de Puerto (Estilo Arduino/Hardware) */}
    <div class="absolute top-2 right-3 font-mono text-[10px] text-neutral-700 group-hover:text-amber-500/30 transition-colors">
        ID_0x{Math.floor(Math.random() * 100)}
    </div>

    <div class="flex items-start gap-5">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded border border-neutral-800 bg-neutral-950 text-amber-500 shadow-inner group-hover:border-amber-500/40 group-hover:shadow-[0_0_15px_rgba(245,158,11,0.2)] transition-all duration-500">
            {icon.startsWith('mdi:') ? (
                <Icon name={icon} class="h-6 w-6" />
            ) : (
                <span class="text-xl font-mono">{icon}</span>
            )}
        </div>

        <div class="flex-1">
            <h3 class="font-display text-sm font-black uppercase tracking-widest text-neutral-100 italic group-hover:text-amber-500 transition-colors">
                {title}
            </h3>
            
            <ul class="mt-3 space-y-2">
                {items.map((item, i) => (
                    <li class="flex items-center gap-2 text-xs font-mono text-neutral-400 group-hover:text-neutral-300 transition-colors">
                        <span class="text-amber-500/40 font-bold opacity-0 group-hover:opacity-100 transition-opacity">>></span>
                        <Fragment set:html={item} />
                    </li>
                ))}
            </ul>

            {link && (
                <div class="mt-4 pt-3 border-t border-neutral-800/50">
                    <a
                        href={link.href}
                        class="inline-flex items-center font-mono text-[11px] uppercase tracking-tighter text-amber-500 hover:text-white transition-all duration-300"
                    >
                        <span class="mr-2">[</span> {link.text} <span class="ml-2">]</span>
                        <Icon name="mdi:arrow-right" class="ml-2 h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" />
                    </a>
                </div>
            )}
        </div>
    </div>
</div>

<style>
    /* Efecto de parpadeo sutil en el icono cuando la tarjeta está activa */
    .group:hover .shrink-0 {
        animation: pulse-border 2s infinite;
    }

    @keyframes pulse-border {
        0%, 100% { border-color: rgba(245, 158, 11, 0.4); }
        50% { border-color: rgba(245, 158, 11, 0.8); }
    }
</style>