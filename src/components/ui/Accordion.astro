---
import { Icon } from "astro-icon/components";
const { question, answer, modeDisplay } = Astro.props;
---

{modeDisplay ? (
    <div class="accordion-item rounded-xl border border-neutral-700 bg-neutral-800/50 overflow-hidden">
        <button
        class="accordion-question flex w-full items-center justify-between px-5 py-4 text-left font-medium text-neutral-200 hover:text-purple-400 transition-colors"
        aria-expanded="false"
    >
        <span>{question}</span>
        <Icon name="mdi:chevron-down" class="h-5 w-5 transform transition-transform duration-300" />
    </button>
    <div class="accordion-answer px-5 pb-4 pt-0 text-neutral-400 hidden">
        <div class="border-t border-neutral-700 pt-4">
        {answer}
        </div>
    </div>
</div>
) : (
    <div class="border-l-4 border-purple-500 bg-neutral-900/50 p-4 font-mono">
        <div class="text-purple-400">$ {question}</div>
        <div class="mt-2 text-neutral-300 pl-4">> {answer}</div>
    </div>
)
}

    <style is:global>
    .accordion-item[aria-expanded="true"] .accordion-question {
        @apply text-purple-400;
    }
    .accordion-item[aria-expanded="true"] .accordion-question svg {
        @apply rotate-180;
    }
    </style>

    <script is:inline>
        document.querySelectorAll('.accordion-question').forEach(button => {
            button.addEventListener('click', () => {
                const isExpanded = button.getAttribute('aria-expanded') === 'true';
                button.setAttribute('aria-expanded', !isExpanded);

                const answer = button.nextElementSibling;
                if (isExpanded) {
                    answer.classList.add('hidden');
                } else {
                    answer.classList.remove('hidden');
                }
            });
        });
    </script>