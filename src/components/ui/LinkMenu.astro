---
const { url, name, class: className = "", activeClass = "" } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = currentPath === url;
---

<a 
    href={url}
    class={`${className} ${isActive ? activeClass : ''}`}
    aria-current={isActive ? 'page' : undefined}
>
    {name}
    {isActive && (
        <span class="absolute inset-x-1 -bottom-px h-px bg-gradient-to-r from-amber-400/0 via-amber-400/70 to-amber-400/0"></span>
    )}
</a>