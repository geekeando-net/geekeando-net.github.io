---
const { title, subTitle, align = "center", accentColor = "amber" } = Astro.props as {
    title: string;
    subTitle?: string;
    align?: "center" | "left";
    accentColor?: keyof typeof colorVariants;
};

// Paletas de color para el acento (puedes añadir más)
const colorVariants = {
    amber: "from-amber-400 to-amber-600",
    purple: "from-purple-400 to-pink-600",
    blue: "from-blue-400 to-cyan-600",
    green: "from-emerald-400 to-teal-600"
};
---
<div class={`${align === "center" ? "text-center mx-auto" : "text-left"} max-w-3xl`}>
    <!-- Título con gradiente dinámico -->
    <h1 class="text-balance text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl md:text-5xl md:leading-tight [text-wrap:balance]">
        <span class={`bg-gradient-to-r ${colorVariants[accentColor]} bg-clip-text text-transparent`}>
            {title}
        </span>
    </h1>

    <!-- Subtítulo con animación sutil -->
    {subTitle && (
        <p class={`mt-4 text-pretty text-lg leading-relaxed text-neutral-400 ${align === "center" ? "mx-auto" : ""} md:max-w-[80%]`}>
            {subTitle}
        </p>
    )}

    <!-- Decoración opcional (raya decorativa) -->
    {align === "center" && (
        <div class={`mt-6 h-1 w-20 mx-auto bg-gradient-to-r ${colorVariants[accentColor]} rounded-full`}></div>
    )}
</div>

<style>
    /* Animación para el subtítulo */
    p {
        animation: fadeIn 0.8s ease-out forwards;
    }
    h1 {
        text-shadow: 0 0 8px rgba(251, 191, 36, 0.3);
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>