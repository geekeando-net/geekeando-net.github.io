---
const { title, subTitle, align = "center", accentColor = "amber" } = Astro.props as {
    title: string;
    subTitle?: string;
    align?: "left" | "left";
    accentColor?: "amber" | "purple" | "blue" | "green";
};

// Paletas de color optimizadas para fondos oscuros
const colorVariants = {
    amber: {
        gradient: "from-amber-400 to-orange-600",
        shadow: "rgba(251, 191, 36, 0.4)",
        border: "border-amber-500/50"
    },
    purple: {
        gradient: "from-purple-400 to-fuchsia-600",
        shadow: "rgba(168, 85, 247, 0.4)",
        border: "border-purple-500/50"
    },
    blue: {
        gradient: "from-blue-400 to-indigo-600",
        shadow: "rgba(59, 130, 246, 0.4)",
        border: "border-blue-500/50"
    },
    green: {
        gradient: "from-emerald-400 to-teal-600",
        shadow: "rgba(16, 185, 129, 0.4)",
        border: "border-emerald-500/50"
    }
};

const currentVariant = colorVariants[accentColor] || colorVariants.amber;
---

<div class={`text-left max-w-4xl group`}>
    
    {/* Badge de Sistema (Opcional, da un toque muy geek) */}
    <div class={`inline-block mb-3 px-2 py-1 border-l-2 ${currentVariant.border} bg-neutral-900/50`}>
        <span class="text-[10px] font-mono tracking-[0.3em] text-neutral-500 uppercase">
            System_Header::{accentColor}
        </span>
    </div>

    {/* Título con Fuente Display (Orbitron) */}
    <h1 class="font-display text-balance text-3xl font-black tracking-tighter text-neutral-100 sm:text-5xl md:text-6xl uppercase italic leading-none">
        <span class={`bg-gradient-to-r ${currentVariant.gradient} bg-clip-text text-transparent drop-shadow-sm`}>
            {title}
        </span>
    </h1>

    {/* Subtítulo con Fuente Sans (Inter) */}
    {subTitle && (
        <p class={`mt-4 text-pretty text-sm md:text-base font-light leading-relaxed text-neutral-500 ${align === "center" ? "mx-auto" : ""} max-w-2xl font-mono`}>
            <span class="text-neutral-700 font-bold mr-2">>></span>
            {subTitle}
        </p>
    )}

    {/* Decoración: Barra de carga/progreso */}
    <div class={`mt-8 flex ${align === "center" ? "justify-center" : "justify-start"} items-center gap-2`}>
        <div class={`h-[2px] w-24 bg-gradient-to-r ${currentVariant.gradient} opacity-50`}></div>
        <div class={`h-1 w-1 bg-${accentColor}-500 rotate-45`}></div>
    </div>
</div>

<style define:vars={{ glowColor: currentVariant.shadow }}>
    h1 {
        /* Usamos la variable de resplandor dinámica */
        filter: drop-shadow(0 0 15px var(--glowColor));
    }
    
    p {
        animation: scanline 1s ease-out forwards;
    }

    @keyframes scanline {
        from { opacity: 0; transform: translateX(-10px); }
        to { opacity: 1; transform: translateX(0); }
    }
</style>