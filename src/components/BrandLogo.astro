---
// BrandLogo.astro
const { class: className = "" } = Astro.props;
---
<div 
  class={`flex items-center gap-3 group cursor-pointer animate-reveal ${className}`}
>
  <div class="relative flex items-center justify-center">
    <img 
      src="/geekeando.svg" 
      alt="Logo Geekeando" 
      class="h-10 w-auto md:h-12 z-10 transition-all duration-500 group-hover:scale-110" 
    />
    <div class="absolute inset-0 bg-amber-500/0 group-hover:bg-amber-500/20 blur-xl rounded-full transition-all duration-700"></div>
  </div>

  <div class="flex flex-col border-l border-neutral-700/60 pl-3 transition-all duration-500 group-hover:border-amber-500/50">
    <span class="font-display text-xl md:text-2xl font-black uppercase tracking-tighter text-white transition-colors duration-300 group-hover:text-amber-400">
      Geekeando
    </span>
    
    <span class="font-mono text-[9px] md:text-[10px] text-amber-500 lowercase mt-1 opacity-80 leading-none transition-all duration-700 ease-out tracking-[0.1em] group-hover:tracking-[0.25em] group-hover:text-white group-hover:opacity-100">
      ser geek también es un trabajo
    </span>
  </div>
</div>

<style is:global>
  /* Fuentes de marca */
  .font-display { font-family: 'Orbitron', sans-serif; }
  .font-mono { font-family: 'Fira Code', monospace; }

  /* 1. Animación de Entrada (Reveal) */
  @keyframes reveal {
    0% {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(5px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .animate-reveal {
    animation: reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* 2. Animación de Latido (Pulse) al hacer Hover */
  @keyframes geek-pulse {
    0%, 100% { transform: scale(1); filter: brightness(1); }
    50% { transform: scale(1.05); filter: brightness(1.25); }
  }

  .group:hover img {
    animation: geek-pulse 2s infinite ease-in-out;
  }
</style>