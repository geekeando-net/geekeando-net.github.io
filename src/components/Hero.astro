---
import heroImage from '@images/hero-geekeando.jpg';
import { Icon } from 'astro-icon/components';
---

<section class="relative overflow-hidden bg-neutral-950 border-b border-neutral-900">
    {/* Fondo de rejilla técnica */}
    <div class="absolute inset-0 opacity-[0.05] z-0" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative h-[600px] md:h-[700px] z-10">
        
        {/* SLIDE 01: WELCOME LOG */}
        <div id="slide1" class="absolute inset-0 transition-opacity duration-1000 opacity-100">
            <div class="mx-auto grid max-w-[85rem] h-full gap-4 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center lg:px-8">
                <div class="space-y-8 animate-fade-in-left">
                    <div class="inline-flex items-center gap-x-2 rounded border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-[10px] font-mono text-amber-500 uppercase tracking-[0.2em]">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                        </span>
                        SYSTEM_STATUS: ONLINE_V2.0.25
                    </div>
                    
                    <h1 class="font-display text-4xl font-black tracking-tighter text-white sm:text-6xl lg:text-7xl leading-none uppercase">
                        Domina tus <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-600">Hobbies</span>
                    </h1>
                    
                    <p class="font-mono text-[13px] md:text-sm leading-relaxed text-neutral-500 lg:w-4/5 border-l-2 border-amber-500/50 pl-4">
                        // INITIALIZING_CORE_RESOURCES...<br/>
                        Arduino, Papercraft, 3D Print & Music Tech.<br/>
                        Proyectos open-source para elevar tu nivel maker.
                    </p>
                    
                    <div class="flex flex-wrap gap-4">
                        <button class="group relative overflow-hidden rounded-md bg-amber-500 px-8 py-4 text-[11px] font-mono font-bold text-neutral-950 transition-all hover:shadow-[0_0_25px_rgba(245,158,11,0.4)] uppercase tracking-widest">
                            <span class="relative z-10 flex items-center gap-2">
                                [ EXPLORAR_LABS ] <Icon name="mdi:code-tags" class="h-4 w-4" />
                            </span>
                        </button>
                        <button class="rounded-md border border-neutral-700 bg-neutral-900/50 px-8 py-4 text-[11px] font-mono font-bold text-white hover:border-amber-500 transition-all uppercase tracking-widest">
                            {`> ÚNETE_AL_CLAN`}
                        </button>
                    </div>
                </div>

                {/* Imagen con efecto de monitor antiguo */}
                <div class="relative hidden md:block h-[450px] group">
                    <div class="absolute inset-0 bg-amber-500/5 rounded-2xl rotate-2 group-hover:rotate-3 transition-transform duration-500"></div>
                    <div class="relative h-full overflow-hidden rounded-2xl border border-neutral-800 shadow-2xl">
                        <img
                            src={heroImage.src}
                            alt="Geekeando Lab"
                            class="h-full w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-105"
                        />
                        <div class="absolute top-4 left-4 z-20 pointer-events-none">
                            <div class="bg-neutral-950/80 backdrop-blur-sm border border-neutral-800 p-2 rounded text-[8px] font-mono text-amber-500 uppercase tracking-tighter">
                                Live_Feed: Core_Visuals
                            </div>
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent opacity-80"></div>
                    </div>
                </div>
            </div>
        </div>

        {/* SLIDE 02: PHILOSOPHY */}
        <div id="slide2" class="absolute inset-0 transition-opacity duration-1000 opacity-0">
            <div class="flex h-full items-center justify-center bg-neutral-950 px-4 text-center">
                <div class="max-w-4xl space-y-6">
                    <span class="font-mono text-[10px] text-amber-500/50 uppercase tracking-[0.5em]">System_Philosophy</span>
                    <h2 class="font-display text-4xl font-black text-white sm:text-6xl lg:text-8xl uppercase tracking-tighter">
                        Crea. <span class="text-amber-500 text-glow">Imprime.</span> Suena.
                    </h2>
                    <p class="font-mono text-sm text-neutral-500 max-w-2xl mx-auto italic">
                        "El único límite es el tamaño de tu cama de impresión y la capacidad de tu memoria flash."
                    </p>
                    <div class="pt-8">
                         <button class="inline-flex items-center gap-x-3 rounded-md bg-white px-8 py-4 text-[11px] font-mono font-black text-neutral-900 hover:bg-amber-500 transition-all duration-300 uppercase tracking-[0.2em] shadow-xl">
                            [ VER_REPOSITORIOS ] <Icon name="mdi:rocket-launch" class="h-4 w-4" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {/* Dots de Navegación más técnicos */}
    <div class="absolute bottom-10 left-0 right-0 flex justify-center gap-2 z-20">
        <button onclick="showSlide(1)" class="nav-dot h-[3px] w-12 bg-amber-500 opacity-100 transition-all" aria-label="Slide 1"></button>
        <button onclick="showSlide(2)" class="nav-dot h-[3px] w-12 bg-neutral-800 opacity-50 transition-all" aria-label="Slide 2"></button>
    </div>
</section>

<style>
    .font-display { font-family: 'Orbitron', sans-serif; }
    .font-mono { font-family: 'Fira Code', monospace; }

    .text-glow {
        text-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
    }

    /* Animaciones de entrada */
    @keyframes fade-in-left {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .animate-fade-in-left {
        animation: fade-in-left 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>

<script is:inline>
    let currentSlide = 1;
    function showSlide(n) {
        document.getElementById('slide1').style.opacity = n === 1 ? '1' : '0';
        document.getElementById('slide2').style.opacity = n === 2 ? '1' : '0';
        
        const dots = document.querySelectorAll('.nav-dot');
        dots.forEach((dot, i) => {
            dot.style.opacity = (i + 1 === n) ? '1' : '0.3';
            dot.style.backgroundColor = (i + 1 === n) ? '#f59e0b' : '#3f3f46';
            dot.style.width = (i + 1 === n) ? '48px' : '32px';
        });
        currentSlide = n;
    }

    // Auto-play simple
    setInterval(() => {
        currentSlide = currentSlide === 1 ? 2 : 1;
        showSlide(currentSlide);
    }, 5000);
</script>