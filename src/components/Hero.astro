---
import heroImage from '@images/hero.jpg';
import { Image } from 'astro:assets';

const avatarSrcs: Array<string> = [
    "https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
    "https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
    "https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80",
    "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
];

const { withReview } = Astro.props;
const rating = `<span class="font-bold">4.8</span> / 5`;
const review = `From Over <span class="font-bold">12.8k</span> Reviews`;
const starCount = 4;
---

<section class="mx-auto grid max-w-[85rem] gap-4 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:gap-8 lg:px-8 2xl:max-w-full">
    <div>
        <h1 class="block text-balance text-3xl font-bold tracking-tight text-neutral-200 sm:text-4xl lg:text-6xl lg:leading-tight">
            Disfruta de tu dia y tus hobbies con <span
            class="text-yellow-400">GeeKeando</span>
        </h1>
        <p class="mt-3 text-pretty text-lg leading-relaxed text-neutral-400 lg:w-4/5">
            Encuentra los productos que te gustan y disfruta de tus hobbies con
            la mejor calidad y precio.
        </p>
        
    </div>
    <div class="flex w-full">
        <div class="top-12 overflow-hidden">
            <img
                src={ heroImage.src }
                alt="Hero"
                class="h-full w-full scale-110 object-cover object-center"
            />
        </div>
    </div>
</section>