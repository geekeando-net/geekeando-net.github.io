---
import { Icon } from "astro-icon/components";
import BrandLogo from "@components/BrandLogo.astro";
import stringsNavigation from "@utils/stringsNavigation";

const navigation = stringsNavigation;
---

<footer class="w-full border-t border-neutral-900 bg-neutral-950 overflow-hidden relative">
    <div class="absolute inset-0 bg-[radial-gradient(#1a1a1a_1px,transparent_1px)] [background-size:20px_20px] opacity-20 pointer-events-none"></div>

    <div class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 relative z-10">
        <div class="grid grid-cols-2 gap-12 md:grid-cols-4 lg:grid-cols-5">
            
            <div class="col-span-full lg:col-span-1">
                <div class="flex flex-col items-start gap-8">
                    <BrandLogo />
                    
                    <div class="space-y-4">
                        <p class="text-[10px] font-mono text-neutral-500 leading-relaxed uppercase tracking-tight">
                            <span class="text-amber-500/50">#</span> Laboratorio de experimentación: <br/> 
                            <span class="text-neutral-300">Arduino_Dev // 3D_Printing // Papercraft_Engineer // Audio_FX</span>
                        </p>
                    </div>
                    
                    <div class="flex gap-3">
                        {navigation.socialLinks.map((social) => (
                            <a
                                href={social.url}
                                class="flex h-8 w-8 items-center justify-center border border-neutral-800 bg-neutral-900/50 text-neutral-500 transition-all duration-300 hover:border-amber-500 hover:text-amber-500 group"
                                target="_blank"
                                rel="noopener noreferrer"
                                title={social.name}
                            >
                                <Icon name={social.name} class="h-4 w-4 group-hover:scale-110 transition-transform" />
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            {navigation.footerLinks.map((section) => (
                <div class="col-span-1">
                    <h3 class="text-[10px] font-mono font-black uppercase tracking-[0.3em] text-neutral-400 mb-8 flex items-center gap-2">
                        <span class="h-1 w-1 bg-amber-500"></span>
                        {section.section}
                    </h3>
                    <ul class="space-y-4">
                        {section.links.map((link) => (
                            <li>
                                <a href={link.url} class="group flex items-center gap-x-2 text-[11px] font-mono text-neutral-600 transition-all hover:text-amber-400">
                                    <span class="text-amber-500 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all">>></span>
                                    {link.name.toUpperCase()}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}

            <div class="col-span-full lg:col-span-2">
                <div class="border border-neutral-800 bg-black/40 p-8 relative">
                    <div class="absolute top-0 right-6 px-2 bg-neutral-950 border-x border-b border-neutral-800 text-[8px] font-mono text-neutral-600">SYS_PUSH_NOTIFICATIONS</div>
                    
                    <h3 class="text-xs font-bold text-white mb-4 uppercase tracking-[0.2em] italic">
                        UPLINK_SUBSCRIBE
                    </h3>
                    <p class="text-[10px] font-mono text-neutral-500 mb-8 leading-relaxed">
                        Suscríbete para recibir <span class="text-amber-500/80">patch_notes</span>, esquemas de circuitos y blueprints exclusivos de la comunidad.
                    </p>
                    
                    <form class="flex flex-col gap-3">
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[10px] font-mono text-amber-500/40">IN:</span>
                            <input
                                type="email"
                                placeholder="USER@DOMAIN.NET"
                                class="w-full border border-neutral-800 bg-neutral-900/30 py-3 pl-12 pr-4 text-[10px] font-mono text-neutral-200 focus:border-amber-500/50 outline-none transition-all"
                                required
                            />
                        </div>
                        <button
                            type="submit"
                            class="w-full bg-neutral-800 hover:bg-amber-500 py-3 text-[10px] font-mono font-black uppercase tracking-widest text-neutral-400 hover:text-black transition-all duration-500 border border-neutral-700 hover:border-amber-400"
                        >
                            EXECUTE_CONNECTION
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="my-16 flex items-center gap-4">
            <div class="h-px flex-grow bg-neutral-900"></div>
            <div class="flex gap-2">
                <div class="h-1 w-1 rounded-full bg-neutral-800"></div>
                <div class="h-1 w-1 rounded-full bg-neutral-800"></div>
                <div class="h-1 w-1 rounded-full bg-amber-500/20"></div>
            </div>
            <div class="h-px w-12 bg-neutral-900"></div>
        </div>

        <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
            <div class="flex items-center gap-4">
                <div class="p-2 border border-neutral-800 text-amber-500">
                    <Icon name="mdi:chip" class="h-4 w-4" />
                </div>
                <p class="text-[9px] text-neutral-600 font-mono uppercase tracking-[0.2em]">
                    &copy; {new Date().getFullYear()} GEEKEANDO.LABS // INFRASTRUCTURE_READY
                    <span class="inline-block w-2 h-4 bg-amber-500 ml-2 align-middle animate-blink"></span>
                </p>
            </div>
            
            <nav class="flex flex-wrap justify-center gap-x-8 gap-y-4">
                {['Privacidad', 'Cookies', 'FAQ'].map((item) => (
                    <a href={`/${item.toLowerCase()}`} class="group text-[9px] font-mono text-neutral-600 hover:text-amber-500 transition-colors uppercase tracking-[0.3em] relative">
                        <span class="text-amber-500/0 group-hover:text-amber-500 transition-colors absolute -left-4">./</span>
                        {item}
                    </a>
                ))}
            </nav>
        </div>
    </div>
</footer>

<style is:global>
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
    .animate-blink {
        animation: blink 1s step-end infinite;
    }
</style>