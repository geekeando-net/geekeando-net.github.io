---
import { Icon } from "astro-icon/components";
import BrandLogo from "@components/BrandLogo.astro";
import stringsNavigation from "@utils/stringsNavigation";

const navigation = stringsNavigation;
---

<footer class="w-full border-t border-neutral-800 bg-gradient-to-b from-neutral-900 to-neutral-950 overflow-hidden">
    <div class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
            <div class="col-span-full lg:col-span-1">
                <div class="flex flex-col items-start gap-6">
                    <BrandLogo />
                    
                    <p class="text-sm text-neutral-400 leading-relaxed">
                        Tu portal definitivo sobre tecnología, gaming y cultura geek.
                    </p>
                    
                    <div class="flex gap-3">
                        {navigation.socialLinks.map((social) => (
                            <a
                                href={social.url}
                                class="flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-700 bg-neutral-800/50 text-neutral-400 transition-all duration-300 hover:bg-amber-500 hover:text-neutral-900 hover:border-amber-500 hover:shadow-[0_0_15px_rgba(245,158,11,0.4)] hover:-translate-y-1"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Síguenos en ${social.name}`}
                            >
                                <Icon name={social.name} class="h-5 w-5" />
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            {navigation.footerLinks.map((section) => (
                <div class="col-span-1">
                    <h3 class="text-sm font-bold uppercase tracking-widest text-neutral-200 mb-6 flex items-center gap-2">
                        {section.icon && <Icon name={section.icon} class="h-4 w-4 text-amber-500" />}
                        {section.section}
                    </h3>
                    <ul class="space-y-4">
                        {section.links.map((link) => (
                            <li>
                                <a
                                    href={link.url}
                                    class="group inline-flex items-center gap-x-2 text-sm text-neutral-400 transition-all hover:text-amber-400"
                                >
                                    {link.icon && <Icon name={link.icon} class="h-4 w-4 opacity-70 group-hover:opacity-100 transition-opacity" />}
                                    <span class="relative">
                                        {link.name}
                                        <span class="absolute -bottom-1 left-0 h-px w-0 bg-amber-500 transition-all duration-300 group-hover:w-full"></span>
                                    </span>
                                    {link.external && (
                                        <Icon name="mdi:arrow-top-right" class="h-3 w-3 opacity-0 group-hover:opacity-70 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                                    )}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}

            <div class="col-span-full lg:col-span-2">
                <div class="relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 backdrop-blur-sm shadow-2xl">
                    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-amber-500/10 blur-3xl"></div>
                    
                    <h3 class="text-lg font-bold text-neutral-100 mb-2 font-display uppercase tracking-tight">
                        <span class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent">Newsletter Geek</span>
                    </h3>
                    <p class="text-sm text-neutral-400 mb-6 leading-relaxed">
                        Suscríbete para recibir contenido exclusivo, ofertas especiales y las últimas novedades del mundo geek.
                    </p>
                    <form class="flex flex-col sm:flex-row gap-3">
                        <div class="flex-grow">
                            <label for="footer-email" class="sr-only">Email</label>
                            <input
                                type="email"
                                id="footer-email"
                                placeholder="tucorreo@ejemplo.com"
                                class="w-full rounded-xl border border-neutral-700 bg-neutral-800/80 px-4 py-3 text-sm text-neutral-200 placeholder-neutral-500 transition-all focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 outline-none"
                                required
                            />
                        </div>
                        <button
                            type="submit"
                            class="group inline-flex items-center justify-center gap-x-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 px-6 py-3 text-sm font-bold text-neutral-900 hover:shadow-[0_0_20px_rgba(245,158,11,0.4)] transition-all active:scale-95"
                        >
                            <span>Suscribirse</span>
                            <Icon name="mdi:send" class="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
                        </button>
                    </form>
                    <p class="mt-4 text-[10px] text-neutral-500 flex items-center gap-1">
                        <Icon name="mdi:shield-check-outline" class="h-3 w-3" />
                        Privacidad garantizada. Sin spam, solo contenido épico.
                    </p>
                </div>
            </div>
        </div>

        <div class="my-12 h-px w-full bg-gradient-to-r from-transparent via-neutral-800 to-transparent"></div>

        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
            <div class="flex items-center gap-2">
                 <p class="text-xs text-neutral-500 font-mono">
                    &copy; {new Date().getFullYear()} <span class="text-neutral-400">GEEKEANDO</span>.root<span class="animate-cursor inline-block w-1 h-[1px] bg-amber-500 ml-1"></span>
                </p>
            </div>
            
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
                {['Privacidad', 'Términos', 'Cookies', 'FAQ'].map((item) => (
                    <a href={`/${item.toLowerCase()}`} class="text-xs font-medium text-neutral-500 hover:text-amber-500 transition-colors uppercase tracking-widest">
                        {item}
                    </a>
                ))}
            </div>
        </div>
    </div>
</footer>
<style>
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
    .animate-cursor {
        animation: blink 1s step-end infinite;
        vertical-align: middle;
    }
</style>