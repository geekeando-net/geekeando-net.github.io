---
import { Icon } from "astro-icon/components";
import BrandLogo from "@components/BrandLogo.astro";
import stringsNavigation from "@utils/stringsNavigation";

const navigation = stringsNavigation;
---

<footer class="w-full border-t border-neutral-800 bg-gradient-to-b from-neutral-900 to-neutral-950">
    <div class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <!-- Grid principal -->
        <div class="grid grid-cols-2gap-8 md:grid-cols-4 lg:grid-cols-5">
            <!-- Logo y descripción -->
            <div class="col-span-full lg:col-span-1">
                <div class="flex flex-col items-start gap-6">
                    <BrandLogo class="h-auto w-40 text-amber-400" />
                    <p class="text-sm text-neutral-400">
                        Tu portal definitivo sobre tecnología, gaming y cultura geek.
                    </p>
                    <!-- Redes sociales -->
                    <div class="flex gap-2">
                        {navigation.socialLinks.map((social) => (
                            <a
                                href={social.url}
                                class="flex h-9 w-9 items-center justify-center rounded-lg border border-neutral-700 bg-neutral-800/50 text-neutral-400 transition-all hover:bg-amber-500 hover:text-neutral-900 hover:border-amber-500"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Síguenos en ${social.name}`}
                            >
                                <Icon name={social.name} class="h-5 w-5" />
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Enlaces -->
            {navigation.footerLinks.map((section) => (
                <div class="col-span-1">
                    <h3 class="text-lg font-bold text-neutral-200 mb-4 flex items-center gap-2">
                        {section.icon && <Icon name={section.icon} class="h-5 w-5 text-amber-400" />}
                        {section.section}
                    </h3>
                    <ul class="space-y-3">
                        {section.links.map((link) => (
                            <li>
                                <a
                                    href={link.url}
                                    class="group inline-flex items-center gap-x-2 text-sm text-neutral-400 transition-all hover:text-amber-400"
                                >
                                    {link.icon && <Icon name={link.icon} class="h-4 w-4 opacity-70 group-hover:opacity-100" />}
                                    {link.name}
                                    {link.external && (
                                        <Icon name="mdi:arrow-top-right" class="h-3 w-3 opacity-0 group-hover:opacity-70" />
                                    )}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}

            <!-- Newsletter -->
            <div class="col-span-2 md:col-span-4 lg:col-span-2">
                <div class="rounded-xl border border-neutral-800 bg-neutral-900/50 p-6 backdrop-blur-sm">
                    <h3 class="text-lg font-bold text-neutral-200 mb-2">
                        <span class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent">Newsletter Geek</span>
                    </h3>
                    <p class="text-sm text-neutral-400 mb-4">
                        Suscríbete para recibir contenido exclusivo, ofertas especiales y las últimas novedades del mundo geek.
                    </p>
                    <form class="space-y-3">
                        <div>
                            <label for="footer-email" class="sr-only">Email</label>
                            <input
                                type="email"
                                id="footer-email"
                                placeholder="tucorreo@ejemplo.com"
                                class="block w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-3 text-sm text-neutral-200 placeholder-neutral-500 focus:border-amber-400 focus:ring-1 focus:ring-amber-400/30"
                                required
                            />
                        </div>
                        <button
                            type="submit"
                            class="group w-full inline-flex items-center justify-center gap-x-2 rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 px-4 py-3 text-sm font-bold text-neutral-900 hover:shadow-lg hover:shadow-amber-500/20 transition-all"
                        >
                            Suscribirse
                            <Icon name="mdi:send" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                        </button>
                    </form>
                    <p class="mt-3 text-xs text-neutral-500">
                        Nos preocupamos por tu privacidad. Nunca compartiremos tu email.
                    </p>
                </div>
            </div>

        </div>
        <!-- División -->
        <div class="my-8 h-px w-full bg-gradient-to-r from-transparent via-neutral-700 to-transparent"></div>

        <!-- Copyright y enlaces legales -->
        <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
            <p class="text-sm text-neutral-500">
                &copy; {new Date().getFullYear()} Geekeando. Todos los derechos reservados.
            </p>
            
            <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
                <a href="/politica-privacidad" class="text-sm text-neutral-400 hover:text-amber-400 transition-colors">
                    Política de Privacidad
                </a>
                <a href="/terminos-servicio" class="text-sm text-neutral-400 hover:text-amber-400 transition-colors">
                    Términos de Servicio
                </a>
                <a href="/cookies" class="text-sm text-neutral-400 hover:text-amber-400 transition-colors">
                    Cookies
                </a>
                <a href="/faq" class="text-sm text-neutral-400 hover:text-amber-400 transition-colors">
                    Preguntas Frecuentes
                </a>
            </div>
        </div>
    </div>

</footer>