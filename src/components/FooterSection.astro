---
import stringsNavigation from "@utils/stringsNavigation";
import BrandLogo from "@components/BrandLogo.astro";
import  Icon from "@components/ui/Icon.astro";
const navigation = stringsNavigation;

---

<footer class="w-full bg-neutral-900">
    <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-screen-2xl">
        <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
            <div class="col-span-full lg:col-span-1">
                <BrandLogo class="h-auto w-56" />
            </div>
            {
                navigation.footerLinks.map((section) => (
                    <div class="col-span-1">
                        <h3 class="font-bold text-neutral-200">
                            {section.section}
                        </h3>
                        <ul class="mt-3 grid space-y-3">
                            {
                                section.links.map((link) => (
                                    <li>
                                        <a
                                            href={link.url}
                                            class="inline-flex gap-x-2 rounded-lg text-neutral-600 outline-none ring-zinc-500 transition duration-300 hover:text-neutral-500 focus-visible:ring dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-none"
                                        >
                                            {link.name}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                ))
            }
            <div class="col-span-2">
                <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
                    Únete a nosotros y descubre un mundo de posibilidades.
                </h3>
                <form>
                    <!-- email -->
                    <div
                        class="mt-4 flex flex-col items-center gap-2 rounded-lg bg-neutral-200 p-2 dark:bg-neutral-800 sm:flex-row sm:gap-3"
                    >
                        <div class="w-full">
                            <!-- Label for the email input field, visually hidden but accessible to screen readers -->
                            <label for="hs-email-contacts" class="sr-only">
                                Email
                            </label>
                            <!-- Email input field -->
                            <input
                                type="text"
                                name="footer-input"
                                id="footer-input"
                                autocomplete="email"
                                class="block w-full rounded-lg px-4 py-3 text-sm  focus:border-orange-400 focus:ring-orange-400 disabled:pointer-events-none disabled:opacity-50 border-transparent bg-neutral-700 text-gray-300 placeholder:text-neutral-300 caret-orange-400"
                                placeholder="Ingrese su Email"
                            />
                        </div>
                        <a
                            class="inline-flex w-full items-center justify-center gap-x-2 whitespace-nowrap rounded-lg border border-transparent bg-orange-400 p-3 text-sm font-bold text-neutral-50 outline-none transition duration-300 hover:bg-orange-500 focus-visible:ring disabled:pointer-events-none disabled:opacity-50 ring-zinc-200 focus:outline-none focus:ring-1 sm:w-auto"
                            href="#"
                        >
                            Suscribirme
                        </a>
                    </div>
                    <p class="mt-3 text-sm text-neutral-400">
                        ¿Quieres ser parte de nuestra comunidad? Suscríbete a nuestro newsletter y recibe las últimas novedades en tu bandeja de entrada. ¡Únete a la conversación y descubre todo lo que Geekeando tiene para ofrecerte!
                    </p>
                </form>
            </div>
        </div>
        <div class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
            <div class="flex items-center justify-between">
                <p class="text-sm text-neutral-400">
                    &copy;<span id="current-year"></span> GeekEando. Crafted by
                    <a
                        class="rounded-lg font-medium underline underline-offset-2 outline-none transition duration-300 hover:decoration-dashed focus:outline-none focus-visible:ring ring-zinc-200 hover:text-neutral-300"
                        href="htt://draexx.geekeando.net">Draexx
                    </a>.
                </p>
            </div>
            <div>
                {
                    navigation.socialLinks.map((social) => (
                        <a
                            href={social.url}
                            class="inline-flex h-10 w-10 items-center justify-center gap-x-2 rounded-lg border border-transparent text-sm font-bold text-neutral-700 outline-none focus:outline-none focus-visible:ring focus-visible:ring-zinc-500 ring-zinc-200 hover:bg-neutral-50/10"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Icon name={social.name}/>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</footer>

<script>
    const year = new Date().getFullYear();
    const element = document.getElementById('current-year');
    element!.innerText = year.toString();
</script>