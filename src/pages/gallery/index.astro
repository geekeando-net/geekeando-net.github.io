---
import Layout from "@/layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import 'swiper/css';
import "swiper/css/navigation";
import 'photoswipe/style.css';

const allImagesFile = import.meta.glob("@images/gallery/**/*.*", { eager: true });
const allImages = Object.values(allImagesFile) as any[];

const title = "ASSET_DATABASE";
const subTitle = "// Registro visual de prototipos y diseños 3D";

const allCategories = Array.from(new Set(
    Object.keys(allImagesFile)
        .map(path => path.split('/gallery/')[1]?.split('/')[0])
        .filter((folder) => folder && !folder.includes('.'))
));
---

<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="mx-auto max-w-5xl text-center mb-16">
            <TitleSection title={title} subTitle={subTitle} accentColor="blue" />
            
            {/* Filtros Estilo Terminal */}
            <div class="mt-8 flex flex-wrap justify-center gap-2 font-mono">
                <a href="/gallery" class="filter-btn active">[ ALL_FILES ]</a>
                {allCategories.map((cat) => (
                    <a href={`/gallery/${cat}`} class="filter-btn">
                        {`[ ${cat.toUpperCase()} ]`}
                    </a>
                ))}
            </div>
        </div>

        <div class="relative group">
            <div class="swiper w-full !pb-12">
                <div class="swiper-wrapper" id="my-slider">
                    {allImages.map((image, index) => (
                        <div class="swiper-slide group/card">
                            <a
                                class="block relative overflow-hidden border border-neutral-800 bg-neutral-900 group-hover/card:border-blue-500/50 transition-all duration-500"
                                href={image.default.src}
                                data-pswp-width={image.default.width}
                                data-pswp-height={image.default.height}
                            >
                                {/* Tag de ID de imagen */}
                                <div class="absolute top-2 left-2 z-10 bg-black/80 px-2 py-1 text-[8px] font-mono text-blue-400 border border-blue-500/30 uppercase">
                                    IMG_{index.toString().padStart(3, '0')}
                                </div>

                                <img
                                    src={image.default.src}
                                    alt="Gallery item"
                                    class="w-full h-80 object-cover opacity-80 group-hover/card:opacity-100 group-hover/card:scale-105 transition-all duration-700 grayscale-[50%] group-hover/card:grayscale-0"
                                />

                                {/* Overlay Técnico de Metadatos */}
                                <div class="absolute inset-0 bg-neutral-950/90 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 flex flex-col p-6 font-mono text-[10px]">
                                    <div class="flex justify-between border-b border-blue-500/30 pb-2 mb-4">
                                        <span class="text-blue-500">METADATA_EXTRACTOR</span>
                                        <span class="text-neutral-600">v1.0</span>
                                    </div>
                                    
                                    <div class="space-y-2 text-neutral-400">
                                        <p><span class="text-blue-400">PATH:</span> {image.default.src.split('/').pop().slice(0, 20)}...</p>
                                        <p><span class="text-blue-400">RES:</span> {image.default.width} x {image.default.height} px</p>
                                        <p><span class="text-blue-400">FMT:</span> . {image.default.src.split('.').pop()}</p>
                                    </div>

                                    <div class="mt-auto pt-4 border-t border-neutral-800 flex justify-between items-center">
                                        <span class="text-neutral-500 uppercase tracking-widest">View_High_Res</span>
                                        <div class="h-2 w-2 bg-blue-500 animate-pulse"></div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    ))}
                </div>
                
                {/* Navegación Técnica */}
                <div class="swiper-button-prev !text-blue-500 !bg-neutral-950/80 border border-blue-500/30 !w-10 !h-10"></div>
                <div class="swiper-button-next !text-blue-500 !bg-neutral-950/80 border border-blue-500/30 !w-10 !h-10"></div>
            </div>
        </div>
    </section>
</Layout>

<style>
    @reference '../../styles/global.css';

    /* Estilos de Botones de Filtro Geeks */
    .filter-btn {
        @apply px-4 py-2 text-xs font-mono text-neutral-500 hover:text-blue-400 transition-all duration-300;
    }
    .filter-btn.active {
        @apply text-blue-500 bg-blue-500/5 border-b border-blue-500;
    }

    /* Ajustes de Swiper */
    .swiper-button-next:after, .swiper-button-prev:after {
        font-size: 14px !important;
        font-weight: bold;
    }
    
    .swiper-slide {
        width: 320px; /* Ancho fijo para mantener el look de tarjetas de catálogo */
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Navigation, Autoplay } from "swiper/modules";
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    const swiper = new Swiper(".swiper", {
        modules: [Navigation, Autoplay],
        slidesPerView: "auto",
        spaceBetween: 20,
        centeredSlides: true,
        loop: true,
        autoplay: { delay: 4000 },
        navigation: {
            prevEl: ".swiper-button-prev",
            nextEl: ".swiper-button-next",
        }
    });

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#my-slider',
        children: 'a',
        pswpModule: () => import('photoswipe')
    });
    lightbox.init();
</script>