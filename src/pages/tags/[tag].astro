---
import Layout from "@/layouts/Layout.astro"
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    title: string;
    tags: string[];
    [key: string]: any;
}
interface MarkdownPost {
    frontmatter: Frontmatter;
    url: string;
    file: string;
    rawContent(): string;
    compiledContent(): string;
    Content: any;
}

interface Params {
    tag: string;
}

interface Props {
    posts: MarkdownInstance<MarkdownPost>[];
}

interface StaticPath {
    params: Params;
    props: Props;
}

export const prerender = true;
export async function getStaticPaths(): Promise<StaticPath[]> {
    const allPosts: MarkdownInstance<MarkdownPost>[] = await Astro.glob<MarkdownPost>("@posts/*.md");
    // allPosts.forEach(element => console.log(element));
    const uniqueTags: string[] = [...new Set(allPosts.flatMap((post) => post.frontmatter.tags))];

    return uniqueTags.map((tag) => {
        const filteredPosts: MarkdownInstance<MarkdownPost>[] = allPosts.filter((post) => post.frontmatter.tags.includes(tag));
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}
const { tag } = Astro.params;
const { posts } = Astro.props as { posts: MarkdownInstance<MarkdownPost>[]};
---
<Layout>
    <p>Posts etiquetados con {tag}</p>
    <ul>
        {
            posts.length > 0 ? (
                posts.map((post) => (
                    <li><a href={post.url}>{post.frontmatter.title}</a></li>
                ))
            ) : (
                <li>No hay posts</li>
            )
        }
    </ul>
</Layout>
