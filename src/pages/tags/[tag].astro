---
import Layout from "@/layouts/Layout.astro"
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    layout?: string;
    title?: string;
    pubDate?: string;
    description?: string;
    author?: string;
    image?: {
        url?: string;
        alt?: string;
    };
    tags?: string[];
}
interface MarkdownPost {
    frontmatter: Frontmatter;
    url: string;
    file: string;
    rawContent(): string;
    compiledContent(): string;
    Content: any;
}

interface Props {
    posts: MarkdownInstance<MarkdownPost>[];
}

interface StaticPath {
    params: { tag: string };
    props: { posts: MarkdownPost[] };
}

export const prerender = true;
export async function getStaticPaths(): Promise<StaticPath[]> {
    // Importar todos los archivos .md en la carpeta @posts
    const allPostFiles = import.meta.glob<MarkdownPost>("@posts/*.md", { eager: true });

    // Convertir a un array de objetos
    const allPosts: MarkdownPost[] = Object.values(allPostFiles);
    console.log(allPosts.map((post) => post.frontmatter));
    // Procesar los posts
    const uniqueTags: string[] = [
        ...new Set(allPosts.flatMap((post) => post.frontmatter.tags || []).filter(Boolean)),
    ];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.frontmatter.tags?.includes(tag)
        );
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}
const { tag } = Astro.params;
const { posts } = Astro.props as { posts: MarkdownInstance<MarkdownPost>[]};
---
<Layout>
    <p>Posts etiquetados con {tag}</p>
    <ul>
        {
            posts.length > 0 ? (
                posts.map((post) => (
                    <li>
                        <a href={post.url}>
                            {post.frontmatter?.title ?? "Sin Titulo"}
                        </a>
                    </li>
                ))
            ) : (
                <li>No hay posts</li>
            )
        }
    </ul>
</Layout>
