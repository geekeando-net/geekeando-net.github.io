---
import Layout from "@/layouts/Layout.astro"

interface MarkdownPost {
    frontmatter: {
        title: string;
        tags: string[];
        [key: string]: any;
    };
    url: string;
    file: string;
    rawContent(): string;
    compiledContent(): string;
    Content: any;
}

interface Params {
    tag: string;
}

interface Props {
    posts: MarkdownPost[];
}

interface StaticPath {
    params: Params;
    props: Props;
}

export const prerender = true;
export async function getStaticPaths(): Promise<StaticPath[]> {
    const allPosts: MarkdownPost[] = await Astro.glob<MarkdownPost>("@posts/*.md");
    // allPosts.forEach(element => console.log(element));
    const uniqueTags: string[] = [...new Set(allPosts.flatMap((post) => (post.frontmatter.tags || []) as string[]))];

    return uniqueTags.map((tag) => {
        const filteredPosts: MarkdownPost[] = allPosts.filter((post): post is MarkdownPost => post.frontmatter.tags?.includes(tag) || false);
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}
const { tag } = Astro.params;
const { posts } = Astro.props as { posts: MarkdownPost[]};
---
<Layout>
    <p>Posts etiquetados con {tag}</p>
    <ul>
        {
            posts.length > 0 ? (
                posts.map((post) => (
                    <li><a href={post.url}>{post.frontmatter.title}</a></li>
                ))
            ) : (
                <li>No hay posts</li>
            )
        }
    </ul>
</Layout>
