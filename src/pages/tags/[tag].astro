---
import Layout from "@/layouts/Layout.astro"
import TitleSection from "@/components/ui/TitleSection.astro"
import SinglePost from "@/components/ui/post/SinglePost.astro";
import type { MarkdownInstance } from 'astro';
import { Icon } from "astro-icon/components";

// Interfaces mantenidas pero optimizadas
interface Frontmatter {
    title?: string;
    pubDate?: string;
    description?: string;
    author?: string;
    image?: { url?: string; alt?: string; };
    tags?: string[];
}

export const prerender = true;
export async function getStaticPaths() {
    const allPostFiles = import.meta.glob<MarkdownInstance<Frontmatter>>("@posts/*.md", { eager: true });
    const allPosts = Object.values(allPostFiles);
    const uniqueTags = Array.from(new Set(allPosts.flatMap((post) => post.frontmatter.tags || []).filter(Boolean)));

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => post.frontmatter.tags?.includes(tag));
        return {
            params: { tag },
            props: { postsFilter: filteredPosts },
        };
    });
}

const { tag } = Astro.params;
const { postsFilter } = Astro.props;

// Obtener todos los tags para la nube de filtros lateral o superior
const allPostFiles = import.meta.glob<MarkdownInstance<Frontmatter>>('@posts/*.md', { eager: true });
const tags = [...new Set(Object.values(allPostFiles).flatMap(p => p.frontmatter.tags || []))].filter(Boolean);

const title = `TAG_QUERY: #${tag?.toUpperCase()}`;
const subTitle = `// Filtrando todos los registros asociados a la etiqueta seleccionada`;
---
<Layout title={`Logs - #${tag}`}>
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
        
        {/* Cabecera de Búsqueda */}
        <div class="mb-12 border-b border-neutral-900 pb-10">
            <TitleSection title={title} subTitle={subTitle} />
            
            <div class="mt-8 flex flex-wrap gap-2">
                <a href="/blogs" class="filter-btn">
                    [ ALL_FILES ]
                </a>
                {tags.map((tagFilter) => (
                    <a href={`/tags/${tagFilter}`} 
                       class={`filter-btn ${tagFilter === tag ? 'active' : ''}`}>
                        {`#${tagFilter.toUpperCase()}`}
                    </a>
                ))}
            </div>
        </div>

        {/* Lista de Resultados */}
        <div class="space-y-6">
            {postsFilter.length > 0 ? (
                postsFilter.map((post) => (
                    <SinglePost
                        title={post.frontmatter.title}
                        text={post.frontmatter.description}
                        link={{ href: post.url, text: "ACCESS_FILE_ >>" }}
                        tags={post.frontmatter.tags}
                        pubDate={post.frontmatter.pubDate}
                        author={post.frontmatter.author}
                        image={post.frontmatter.image}
                    />
                ))
            ) : (
                <div class="text-center py-20 border border-dashed border-neutral-800 rounded-xl">
                    <p class="font-mono text-neutral-500 uppercase tracking-widest">
                        Error 404: No se encontraron registros bajo este tag.
                    </p>
                    <a href="/blogs" class="mt-4 inline-block text-amber-500 font-mono text-xs hover:underline">
                        {`<< RESTART_SEARCH`}
                    </a>
                </div>
            )}
        </div>

        {/* Paginación CLI */}
        <div class="mt-16 flex items-center justify-center gap-4 font-mono">
            <button class="pagination-btn disabled">
                <Icon name="mdi:chevron-left" class="h-4 w-4" /> PREV
            </button>
            <div class="flex gap-1">
                <span class="px-3 py-1 bg-amber-500 text-neutral-900 font-bold text-xs">01</span>
            </div>
            <button class="pagination-btn disabled">
                NEXT <Icon name="mdi:chevron-right" class="h-4 w-4" />
            </button>
        </div>
    </section>

    <style>
        @reference '../../styles/global.css';

        .filter-btn {
            @apply px-3 py-1.5 text-[10px] font-mono border border-neutral-800 bg-neutral-900/50 text-neutral-500 hover:border-amber-500/50 hover:text-amber-500 transition-all uppercase tracking-widest;
        }
        .filter-btn.active {
            @apply border-amber-500 bg-amber-500/10 text-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.1)];
        }
        .pagination-btn {
            @apply flex items-center gap-1 px-4 py-2 text-[10px] bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-amber-500 hover:border-amber-500/50 transition-all uppercase tracking-widest;
        }
        .pagination-btn.disabled {
            @apply opacity-30 pointer-events-none;
        }
    </style>
</Layout>
