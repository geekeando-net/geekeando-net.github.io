---
import Layout from "@/layouts/Layout.astro"
import TitleSection from "@/components/ui/TitleSection.astro"
import SinglePost from "@/components/ui/post/SinglePost.astro";
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    layout?: string;
    title?: string;
    pubDate?: string;
    description?: string;
    author?: string;
    image?: {
        url?: string;
        alt?: string;
    };
    tags?: string[];
}
interface MarkdownPost {
    frontmatter: Frontmatter;
    url: string;
    file: string;
    rawContent(): string;
    compiledContent(): string;
    Content: any;
}

interface Props {
    postsFilter: MarkdownInstance<MarkdownPost>[];
}

export const prerender = true;
export async function getStaticPaths() {
    const allPostFiles = import.meta.glob<MarkdownInstance<Frontmatter>>("@posts/*.md", { eager: true });

    // Convertir a un array de objetos
    const allPosts = Object.values(allPostFiles);
    const uniqueTags = Array.from(
        new Set(
            allPosts.flatMap((post) => post.frontmatter.tags || []).filter(Boolean)
        )
    );

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.frontmatter.tags?.includes(tag)
        );
        return {
            params: { tag },
            props: { postsFilter: filteredPosts },
        };
    });
}
const { tag } = Astro.params;
const { postsFilter } = Astro.props as Props;
// Re-import allPostFiles at script level
const allPostFiles = import.meta.glob<MarkdownInstance<Frontmatter>>('@posts/*.md', { eager: true });
const allPostsTags = Object.values(allPostFiles);
const allTags = allPostsTags.map((post: MarkdownInstance<Frontmatter>) => post.frontmatter.tags || []).flat();
const tagCounts = allTags.reduce((acc: Record<string, number>, tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
}, {} as Record<string, number>);
const tags = Object.keys(tagCounts);
const title: string = `Posts etiquetados con  "${tag}"`;
const subTitle: string = "Descubre artículos sobre tecnología, gaming y cultura geek";
const arrowSVG: string = `<svg
class="h-4 w-4 flex-shrink-0 transition ease-in-out group-hover:translate-x-1"
fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" >
<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /> </svg>`;
const urlPath = "/";
---
<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="mx-auto max-w-4xl text-center">
            <TitleSection
                title={ title }
                subTitle={ subTitle }
            />
            <div class="mt-6 flex flex-wrap justify-center gap-3">
                <button class="filter-btn">
                    <a href="/blogs">Todos</a>
                </button>
                {
                    tags.map((tagFilter) => (
                    <button class={`filter-btn ${tagFilter === tag ? 'active' : ''}`}>
                        <a href={`/tags/${tagFilter}`}>
                            {tagFilter}
                        </a>
                    </button>
                    ))
                }
            </div>
        </div>
        <div class="space-y-8">
            {
                postsFilter.length > 0 ? (
                    postsFilter.map((post,index) => (
                        <SinglePost
                            icon = { '' }
                            title = { (post.frontmatter as Frontmatter)?.title || "Sin Titulo" }
                            text = { (post.frontmatter as Frontmatter)?.description }
                            link = { {href:post.url,text:"Continuar Leyendo"} }
                            tags = { (post.frontmatter as Frontmatter)?.tags }
                            pubDate = { (post.frontmatter as Frontmatter)?.pubDate }
                            author = { (post.frontmatter as Frontmatter)?.author }
                            svg = { arrowSVG }
                            image = { (post.frontmatter as Frontmatter)?.image }
                            key = { index }
                        />
                    ))
                ) : (
                <SinglePost
                    icon = { '' }
                    title = { 'No hay posts' }
                    text = { '' }
                    link = { {href:`window.location.href='${urlPath}'`,text:"Go back!"} }
                />
                )
            }
        </div>
         <!-- Paginación (Opcional) -->
         <div class="mt-12 flex justify-center gap-2">
            <button class="pagination-btn disabled" disabled>
                Anterior
            </button>
            <button class="pagination-btn active">1</button>
            <button class="pagination-btn">2</button>
            <button class="pagination-btn">Siguiente</button>
        </div>
    </section>
    <style>
        /* Estilos para los filtros */
        .filter-btn {
            @apply rounded-full px-4 py-2 text-sm font-medium bg-neutral-800 text-neutral-300 hover:bg-amber-400/10 hover:text-amber-400 transition-colors;
        }
        .filter-btn.active {
            @apply bg-amber-500/20 text-amber-400;
        }
        /* Estilos para paginación */
        .pagination-btn {
            @apply rounded-lg px-4 py-2 bg-neutral-800 text-neutral-300 hover:bg-amber-500 hover:text-neutral-900 transition-colors;
        }
        .pagination-btn.active {
            @apply bg-amber-500 text-neutral-900;
        }
        .pagination-btn.disabled {
            @apply opacity-50 cursor-not-allowed;
        }
    </style>
</Layout>
