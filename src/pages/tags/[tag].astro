---
import Layout from "@/layouts/Layout.astro"
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    layout?: string;
    title?: string;
    pubDate?: string;
    description?: string;
    author?: string;
    image?: {
        url?: string;
        alt?: string;
    };
    tags?: string[];
}
interface MarkdownPost {
    frontmatter: Frontmatter;
    url: string;
    file: string;
    rawContent(): string;
    compiledContent(): string;
    Content: any;
}

interface Params {
    tag: string;
}
interface Props {
    postsFilter: MarkdownInstance<MarkdownPost>[];
}

interface StaticPath {
    params: { tag: string };
}

export const prerender = true;
export async function getStaticPaths() {
    const allPostFiles = import.meta.glob<MarkdownInstance<Frontmatter>>("@posts/*.md", { eager: true });

    // Convertir a un array de objetos
    const allPosts = Object.values(allPostFiles);
    // console.log(allPosts.map((post) => post.frontmatter));
    // Procesar los posts
    const uniqueTags = Array.from(
        new Set(
            allPosts.flatMap((post) => post.frontmatter.tags || []).filter(Boolean)
        )
    );

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.frontmatter.tags?.includes(tag)
        );
        return {
            params: { tag },
            props: { postsFilter: filteredPosts },
        };
    });
}
const { tag } = Astro.params;
const { postsFilter } = Astro.props as Props;
// console.log(postsFilter.map((post) => post));
postsFilter.forEach((post, index) => {
        console.log(`Post #${index}:`, JSON.stringify(post.frontmatter, null, 2));
});
---
<Layout>
    <p>Posts etiquetados con {tag}</p>
    <ul>
        {
            postsFilter.length > 0 ? (
            postsFilter.map((post) => (
                    <li>
                        <a href={post.url}>
                            {
                                (post.frontmatter as Frontmatter)?.title || "Sin Titulo"
                            }
                        </a>
                    </li>
                ))
            ) : (
                <li>No hay posts</li>
            )
        }
    </ul>
</Layout>
