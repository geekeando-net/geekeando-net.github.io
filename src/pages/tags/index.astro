---
import Layout from "@/layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    title?: string;
    pubDate?: string;
    description?: string;
    author?: string;
    tags?: string[];
}

const allPosts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('@posts/*.md', { eager: true }));
const allTags = allPosts.map((post) => post.frontmatter.tags || []).flat();
const tagCounts = allTags.reduce((acc: Record<string, number>, tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
}, {} as Record<string, number>);
const tags = Object.keys(tagCounts);

const title = "DATABASE_TAG_CLOUD";
const subTitle = "// Clasificación de registros por frecuencia de uso en el sistema";
---

<Layout title="Etiquetas | Geekeando">
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-5xl">
            <TitleSection title={title} subTitle={subTitle} />
            
            <div class="mt-12 border border-neutral-800 bg-neutral-900/20 p-8 rounded-xl backdrop-blur-sm">
                <ul class="tag-cloud" role="navigation">
                    {tags.map((tag) => (
                        <li>
                            <a 
                                href={`/tags/${tag}`} 
                                data-weight={tagCounts[tag]}
                                class="tag-link"
                            >
                                <span class="hash text-amber-500/30">#</span>{tag.toUpperCase()}
                                <span class="count">[{tagCounts[tag]}]</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>
</Layout>
<style is:global>
    @reference '../../styles/global.css';

    .tag-cloud {
        @apply list-none p-0 flex flex-wrap justify-center items-center gap-4;
        font-family: 'Fira Code', monospace;
    }

    .tag-link {
        @apply relative no-underline transition-all duration-300 flex items-center gap-1;
        --base-color: 245, 158, 11; /* Amber 500 */
    }

    /* Escala de importancia basada en peso */
    .tag-link[data-weight="1"] { font-size: 0.75rem; opacity: 0.4; }
    .tag-link[data-weight="2"] { font-size: 1rem; opacity: 0.6; }
    .tag-link[data-weight="3"] { font-size: 1.25rem; opacity: 0.8; }
    .tag-link[data-weight="4"], 
    .tag-link[data-weight="5"] { font-size: 1.5rem; opacity: 0.9; color: rgb(var(--base-color)); }
    .tag-link[data-weight="6"],
    .tag-link[data-weight="7"] { font-size: 2rem; opacity: 1; color: rgb(var(--base-color)); font-weight: 700; }
    .tag-link[data-weight="8"],
    .tag-link[data-weight="9"] { font-size: 2.5rem; opacity: 1; color: rgb(var(--base-color)); font-weight: 900; text-shadow: 0 0 15px rgba(245, 158, 11, 0.3); }

    .tag-link .count {
        @apply text-[10px] text-neutral-600 ml-1 font-normal;
    }

    .tag-link:hover {
        @apply text-white;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        transform: translateY(-2px);
    }

    .tag-link::after {
        content: '';
        @apply absolute -bottom-1 left-0 w-0 h-[1px] bg-amber-500 transition-all duration-300;
    }

    .tag-link:hover::after {
        @apply w-full;
    }
</style>