---
import Layout from "@layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import CookieTable from "@/components/ui/CookieTable.astro";
import { Icon } from "astro-icon/components";

const title = "COOKIE_PROTOCOL_v2.5";
const lastUpdated = new Date().toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});
---

<Layout title="Protocolo de Cookies | Geekeando">
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        
        <div class="mx-auto max-w-4xl text-center mb-16">
            <div class="inline-block px-3 py-1 mb-4 border border-amber-500/30 bg-amber-500/5 rounded-sm">
                <span class="font-mono text-[10px] text-amber-500 tracking-[0.4em] uppercase">Security_&_Privacy_Sector</span>
            </div>
            <TitleSection
                title={title}
                subTitle={`SYS_LAST_UPDATE: ${lastUpdated.toUpperCase()}`}
                accentColor="amber"
            />
        </div>

        <div class="mx-auto max-w-4xl bg-neutral-950 border border-neutral-800 shadow-[20px_20px_0px_rgba(0,0,0,0.5)] overflow-hidden">
            
            {/* Pestañas simuladas de terminal */}
            <div class="flex border-b border-neutral-800 bg-neutral-900/50">
                <div class="px-6 py-3 border-r border-neutral-800 bg-neutral-950 text-amber-500 font-mono text-xs italic">
                    README.md
                </div>
                <div class="px-6 py-3 border-r border-neutral-800 text-neutral-600 font-mono text-xs hover:text-neutral-400 cursor-help">
                    SECURITY_LOGS
                </div>
            </div>

            <div class="p-8 md:p-12 font-mono">
                <div class="mb-12 relative group">
                    <div class="absolute -left-6 top-0 text-amber-500/20 text-xl font-black">01</div>
                    <h2 class="text-lg font-bold text-white mb-6 flex items-center gap-3 tracking-tighter uppercase italic">
                        <Icon name="mdi:cookie" class="h-5 w-5 text-amber-500" />
                        Definición_de_Paquetes (Cookies)
                    </h2>
                    <p class="text-sm text-neutral-400 leading-relaxed">
                        Las cookies son pequeños archivos de texto que el <span class="text-neutral-200">[SERVER]</span> coloca en su dispositivo para almacenar parámetros de sesión y actividad. En <span class="text-amber-500">Geekeando Labs</span> procesamos estos datos para optimizar la interfaz de usuario.
                    </p>
                </div>

                <div class="mb-12 relative group">
                    <div class="absolute -left-6 top-0 text-amber-500/20 text-xl font-black">02</div>
                    <h2 class="text-lg font-bold text-white mb-6 flex items-center gap-3 tracking-tighter uppercase italic">
                        <Icon name="mdi:database-cog" class="h-5 w-5 text-amber-500" />
                        Módulos_Instalados
                    </h2>
                    <div class="overflow-x-auto border border-neutral-800 bg-black/40 p-1">
                        <CookieTable />
                    </div>
                    <div class="mt-6 flex items-start gap-4 p-4 bg-amber-500/5 border border-amber-500/20">
                        <Icon name="mdi:shield-alert" class="h-10 w-10 text-amber-500 shrink-0" />
                        <p class="text-[11px] text-amber-200/70 leading-normal">
                            <strong class="text-amber-500 uppercase">Aviso Crítico:</strong> Las cookies esenciales son necesarias para mantener la integridad de la sesión. No pueden ser deshabilitadas por el protocolo de usuario.
                        </p>
                    </div>
                </div>

                <div class="mb-12 relative group">
                    <div class="absolute -left-6 top-0 text-amber-500/20 text-xl font-black">03</div>
                    <h2 class="text-lg font-bold text-white mb-6 flex items-center gap-3 tracking-tighter uppercase italic">
                        <Icon name="mdi:console-line" class="h-5 w-5 text-amber-500" />
                        Override_User_Control
                    </h2>
                    <p class="text-sm text-neutral-400 mb-6">
                        Usted puede ejecutar un <span class="text-neutral-200 italic">"Full Wipe"</span> de las cookies mediante:
                    </p>
                    <ul class="text-xs text-neutral-500 space-y-3">
                        <li class="flex items-start gap-3">
                            <span class="text-amber-500">>></span>
                            <span><strong class="text-neutral-300">Navegador:</strong> Modificar parámetros en <code class="bg-neutral-800 px-1 text-amber-400">Settings > Privacy</code>.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-amber-500">>></span>
                            <span><strong class="text-neutral-300">Third-Party:</strong> Implementación de <a href="https://www.aboutcookies.org/" target="_blank" class="text-amber-500 hover:underline">AboutCookies.org</a>.</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-16 pt-8 border-t border-neutral-900 flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="text-left">
                        <h3 class="text-sm font-bold text-white uppercase mb-1">Direct_Channel</h3>
                        <p class="text-[10px] text-neutral-500">privacidad@geekeando.net</p>
                    </div>
                    <a href="mailto:privacidad@geekeando.net" class="px-6 py-2 border border-neutral-700 text-[10px] text-neutral-400 hover:border-amber-500 hover:text-amber-500 transition-all uppercase tracking-widest">
                        Enviar_Consulta
                    </a>
                </div>
            </div>
        </div>
    </section