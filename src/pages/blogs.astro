---
import Layout from "@/layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import SinglePostCard from "@/components/ui/post/SinglePostCard.astro";
import { Icon } from "astro-icon/components";

const allPostsFile = import.meta.glob('@posts/*.md', { eager: true });

const allPosts = Object.entries(allPostsFile).map(([filePath, post]: any) => {
    const slug = filePath.split('/').pop()?.replace('.md', '');
    return {
        ...post.frontmatter,
        url: `/posts/${slug}`,
        pubDate: new Date(post.frontmatter?.pubDate || Date.now()),
    };
});

// Extracción de tags única
const tags = [...new Set(allPosts.map((post) => post.tags).flat())].filter(Boolean);

const sortedPosts = allPosts.sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const title = "BIBLIOTECA_DE_LOGS";
const subTitle = "// Documentación técnica, guías maker y tutoriales de hardware";
---
<Layout title="Blog | Geekeando">
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
        
        <div class="mb-12 border-b border-neutral-900 pb-10">
            <TitleSection title={title} subTitle={subTitle} accentColor="amber"/>
            
            {/* Filtros estilo Terminal */}
            <div class="mt-8 flex flex-wrap gap-2">
                <span class="text-[10px] font-mono text-neutral-600 self-center mr-2">FILTER_BY:</span>
                <a href="/blog" class="filter-btn active">ALL_FILES</a>
                {tags.map((tag) => (
                    <a href={`/tags/${tag}`} class="filter-btn">
                        {`#${tag.toUpperCase()}`}
                    </a>
                ))}
            </div>
        </div>

        {/* Grid de Posts */}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {sortedPosts.map((post) => (
                <SinglePostCard
                    link={{ href: post.url, text: "READ_ENTRY_ >>" }}
                    title={post.title}
                    text={post.description}
                    image={post.image}
                    pubDate={post.pubDate}
                    tags={post.tags}
                    author={post.author}
                />
            ))}
        </div>

        {/* Paginación Estilo CLI */}
        <div class="mt-20 flex items-center justify-center gap-4 font-mono">
            <button class="pagination-btn disabled">
                <Icon name="mdi:chevron-left" class="h-4 w-4" /> PREV
            </button>
            <div class="flex gap-1 text-[11px]">
                <span class="px-3 py-1 bg-amber-500 text-neutral-900 font-bold">01</span>
                <span class="px-3 py-1 bg-neutral-900 text-neutral-500 border border-neutral-800">02</span>
                <span class="px-3 py-1 bg-neutral-900 text-neutral-500 border border-neutral-800">03</span>
            </div>
            <button class="pagination-btn">
                NEXT <Icon name="mdi:chevron-right" class="h-4 w-4" />
            </button>
        </div>
    </section>

    <style>
        @reference '../styles/global.css';

        .filter-btn {
            @apply px-3 py-1.5 text-[10px] font-mono border border-neutral-800 bg-neutral-900/50 text-neutral-500 hover:border-amber-500/50 hover:text-amber-500 transition-all uppercase tracking-widest;
        }
        .filter-btn.active {
            @apply border-amber-500 bg-amber-500/10 text-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.1)];
        }
        .pagination-btn {
            @apply flex items-center gap-1 px-4 py-2 text-[10px] bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-amber-500 hover:border-amber-500/50 transition-all uppercase tracking-widest;
        }
        .pagination-btn.disabled {
            @apply opacity-30 pointer-events-none;
        }
    </style>
</Layout>