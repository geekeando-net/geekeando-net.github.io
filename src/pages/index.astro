---
import Layout from '@layouts/Layout.astro';
import HeroSection from '@/components/Hero.astro';
import CategoryPill from '@/components/ui/CategoryPill.astro';
import BlogPostCard from '@/components/ui/BlogPostCard.astro';
import { Icon } from 'astro-icon/components';

// Datos de ejemplo (deberían venir de tu CMS/API)
const featuredProjects = [
	{
		category: "Arduino",
		title: "Sistema de Riego Inteligente",
		image: "/images/projects/featured-arduino.jpg",
		description: "Control automático de riego con IoT y sensores de humedad",
		slug: "riego-inteligente",
		tags: ["IoT", "Automatización"],
		difficulty: "Intermedio"
	},
  // ... 2-3 proyectos más
];
const allPostsFile = import.meta.glob('@posts/*.md', { eager: true });

const allPosts = Object.entries(allPostsFile).map(([filePath, post]) => {
    const flatPost = Object.assign({}, post) as { frontmatter: { pubDate?: string } };
    const slug = filePath.replace('/src/pages/posts/', '').replace('.md', '');
    return {
        ...flatPost,
        url: `/posts/${slug}`,
        pubDate: new Date(flatPost.frontmatter?.pubDate || 0),
    };
});
const featuredPosts = allPosts.sort((a, b) =>
    (b?.pubDate?.getTime() || 0) - (a?.pubDate?.getTime() || 0)
);
// Datos de ejemplo para el blog (deberían venir de tu CMS)

const projectCategories = [
	{
	id: "arduino",
	name: "Arduino",
	icon: "mdi:chip",
	description: "Proyectos de electrónica y automatización con Arduino",
	projects: [
		{
		title: "Sistema de Riego Automático",
		slug: "riego-automatico",
		image: "/images/projects/arduino-irrigation.jpg",
		tags: ["IoT", "Automatización", "Jardinería"],
		date: "2023-10-15",
		difficulty: "Intermedio",
		components: ["Arduino Uno", "Sensor humedad"],
		featured: true
		}
	]
	},
	{
	id: "paper-craft",
	name: "Paper Craft",
	icon: "mdi:paper-cut-vertical",
	description: "Creaciones artísticas en papel y cartón",
	projects: [
		{
		title: "Maqueta de Ciudad Futurista",
		slug: "ciudad-futurista",
		image: "/images/projects/paper-city.jpg",
		tags: ["Escala 1:100", "Arquitectura"],
		date: "2023-11-05",
		difficulty: "Principiante",
		materials: ["Cartulina", "Pegamento"]
		}
	]
	},
	{
	id: "3d-print",
	name: "3D Print",
	icon: "mdi:printer-3d",
	description: "Diseño e impresión 3D de objetos y prototipos",
	projects: [
		{
		title: "Brazo Robótico Modular",
		slug: "brazo-robotico",
		image: "/images/projects/robotic-arm.jpg",
		tags: ["Robótica", "Open Source"],
		date: "2023-09-18",
		difficulty: "Intermedio",
		stlFiles: ["/downloads/arm.stl"]
		}
	]
	},
	{
	id: "music",
	name: "Music",
	icon: "mdi:music",
	description: "Proyectos musicales y de audio tecnología",
	projects: [
		{
		title: "Sintetizador DIY",
		slug: "sintetizador-diy",
		image: "/images/projects/diy-synth.jpg",
		tags: ["Electrónica", "Música"],
		date: "2023-07-30",
		difficulty: "Avanzado",
		schematics: "/downloads/synth-circuit.pdf"
		}
	]
	}
];
const stats = {
	projects: 124,
	categories: 8,
	community: 2300
};
---

<Layout title="Welcome to GeekEando">
	<HeroSection />
	<!-- Stats -->
	<section class="py-12 border-b border-neutral-800">
	<div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-800">
		<div class="text-center p-6">
			<p class="text-4xl font-bold text-purple-400">{stats.projects}+</p>
			<p class="mt-2 text-neutral-400">Proyectos publicados</p>
		</div>
		<div class="text-center p-6">
			<p class="text-4xl font-bold text-pink-400">{stats.categories}</p>
			<p class="mt-2 text-neutral-400">Categorías diferentes</p>
		</div>
		<div class="text-center p-6">
			<p class="text-4xl font-bold text-blue-400">{stats.community}+</p>
			<p class="mt-2 text-neutral-400">Miembros activos</p>
		</div>
		</div>
	</div>
	</section>
	<!-- Proyectos Destacados -->
	<section class="py-16">
		<div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
				<div>
				<h2 class="text-2xl font-bold text-neutral-200 sm:text-3xl">Proyectos Destacados</h2>
				<p class="text-neutral-400 mt-2">Selección de nuestras creaciones más populares</p>
				</div>
				<a href="/projects" class="text-purple-400 hover:text-purple-300 flex items-center gap-1">
				Ver todos los proyectos
				<Icon name="mdi:arrow-right" class="h-5 w-5" />
				</a>
			</div>
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{featuredProjects.map((project) => (
				<a href={`/projects/${project.category.toLowerCase()}/${project.slug}`} class="group block hover:no-underline">
					<div class="relative rounded-xl overflow-hidden border border-neutral-800 bg-neutral-900/50 hover:border-purple-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/10">
					<div class="aspect-[4/3] overflow-hidden">
						<img
						src={project.image}
						alt={project.title}
						class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
					</div>
					<div class="p-6">
						<div class="flex justify-between items-start mb-3">
						<CategoryPill category={project.category} />
						<span class={`text-xs px-2 py-1 rounded-full border ${
							project.difficulty === "Principiante" 
							? "bg-green-900/50 text-green-400 border-green-800" 
							: project.difficulty === "Intermedio" 
								? "bg-amber-900/50 text-amber-400 border-amber-800" 
								: "bg-red-900/50 text-red-400 border-red-800"
						}`}>
							{project.difficulty}
						</span>
						</div>
						<h3 class="text-xl font-bold text-neutral-200 mb-2 group-hover:text-purple-400 transition-colors">
						{project.title}
						</h3>
						<p class="text-neutral-400 line-clamp-2">{project.description}</p>
						<div class="mt-4 flex flex-wrap gap-2">
						{project.tags.map((tag) => (
							<span class="text-xs px-2 py-1 rounded-full bg-neutral-800 text-neutral-400">
							{tag}
							</span>
						))}
						</div>
					</div>
					</div>
				</a>
				))}
			</div>
		</div>
	</section>
	<!-- Categorías -->
	<section class="py-16 bg-gradient-to-br from-neutral-900/50 to-purple-900/10">
	<div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-12">
		<h2 class="text-2xl font-bold text-neutral-200 sm:text-3xl">Explora por Categorías</h2>
		<p class="text-neutral-400 mt-2 max-w-2xl mx-auto">
			Encuentra proyectos que se ajusten a tus intereses y habilidades
		</p>
		</div>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{projectCategories.map((category) => (
			<a
			href={`/proyectos/${category.id}`}
			class="group relative overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 p-6 hover:border-purple-500/30 transition-all duration-300"
			>
			<div class="flex items-center gap-4">
				<div class="flex items-center justify-center rounded-lg bg-purple-500/10 p-3 text-purple-400 group-hover:bg-purple-500/20 transition-colors">
				<Icon name={category.icon} class="h-6 w-6" />
				</div>
				<div>
				<h3 class="font-bold text-neutral-200 group-hover:text-purple-400 transition-colors">
					{category.name}
				</h3>
				<p class="text-sm text-neutral-500">{category.projects.length} proyectos</p>
				</div>
			</div>
			<p class="mt-4 text-sm text-neutral-400 line-clamp-2">{category.description}</p>
			</a>
		))}
		</div>
	</div>
	</section>
	<!-- CTA Final -->
	<section class="py-16">
	<div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
		<div class="rounded-xl bg-[url('/images/cta-bg.jpg')] bg-cover bg-center border border-neutral-800 overflow-hidden">
		<div class="bg-neutral-900/80 backdrop-blur-sm p-12 text-center">
			<h2 class="text-2xl font-bold text-neutral-200 sm:text-3xl mb-4">¿Listo para compartir tu proyecto?</h2>
			<p class="text-neutral-400 max-w-2xl mx-auto mb-6">
			Únete a nuestra comunidad de creadores y muestra al mundo tus inventos
			</p>
			<div class="flex flex-wrap justify-center gap-4">
			<a
				href="/comunidad/registro"
				class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 px-6 py-3 font-bold text-neutral-100 hover:shadow-lg hover:shadow-purple-500/20 transition-all"
			>
				Crear cuenta gratis
			</a>
			<a
				href="/proyectos/subir"
				class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-neutral-700 px-6 py-3 font-medium text-neutral-300 hover:bg-neutral-800 transition-colors"
			>
				Subir proyecto
			</a>
			</div>
		</div>
		</div>
	</div>
	</section>
	<section class="py-16 border-t border-neutral-800">
		<div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
			<div>
				<h2 class="text-2xl font-bold text-neutral-200 sm:text-3xl">Artículos Recientes</h2>
				<p class="text-neutral-400 mt-2">Tutoriales, guías y contenido técnico para makers</p>
			</div>
			<a href="/blog" class="text-purple-400 hover:text-purple-300 flex items-center gap-1">
				Ver todos los artículos
				<Icon name="mdi:arrow-right" class="h-5 w-5" />
			</a>
			</div>
		
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{featuredPosts.map((post) => (
				<BlogPostCard
				title = { (post.frontmatter as Frontmatter)?.title || "Sin título"}
				excerpt= { (post.frontmatter as Frontmatter)?.description }
				tags = { (post.frontmatter as Frontmatter)?.tags}
				date = { (post.frontmatter as Frontmatter)?.pubDate }
				slug = {post.url}
				image = { (post.frontmatter as Frontmatter)?.image}
				readingTime = "8 min"
				/>
			))}
			</div>
		</div>
	</section>
</Layout>
