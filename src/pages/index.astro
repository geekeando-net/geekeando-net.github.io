---
import { getCollection } from "astro:content";
import Layout from '@layouts/Layout.astro';
import HeroSection from '@/components/Hero.astro';
import { Icon } from 'astro-icon/components';

// 1. Cargamos todos los archivos Markdown del blog
const allPostsFile = import.meta.glob('../pages/posts/*.md', { eager: true });
// 2. Procesamos y ordenamos por fecha (del más reciente al más antiguo)
const latestPosts = Object.entries(allPostsFile)
    .map(([filePath, post]: any) => {
        const slug = filePath.split('/').pop()?.replace('.md', '');
        const dateValue = post.frontmatter.pubDate 
            ? new Date(post.frontmatter.pubDate) 
            : new Date();
        return {
            ...post.frontmatter,
            url: `/posts/${slug}`,
            // Guardamos el objeto Date real
            pubDate: dateValue 
        };
    })
    // Ordenamos usando el tiempo en milisegundos
    .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
    .slice(0, 3); // <--- Aquí limitamos a los últimos 3
// Datos de ejemplo para el blog (deberían venir de tu CMS)
// 1. Obtenemos todos los proyectos dinámicos de la colección
const allProjects = await getCollection("projects");
// 2. Definir los destacados (puedes filtrar por los que tengan featured: true en el MD)
// Si aún no tienes ese campo, simplemente toma los últimos 3
// Filtrado de destacados
const displayProjects = allProjects
    .filter(project => project.data.featured === true) 
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

// Fallback si no hay destacados
const finalProjects = displayProjects.length > 0 ? displayProjects : allProjects.slice(0, 3);

// 5. Categorías con contador real (lo que hicimos antes)
const baseCategories = [
    { id: "arduino", name: "Arduino", icon: "mdi:chip", description: "Proyectos de electrónica..." },
    { id: "papercraft", name: "Paper Craft", icon: "mdi:paper-cut-vertical", description: "Ingeniería en papel..." },
    { id: "3d-print", name: "3D Print", icon: "mdi:printer-3d", description: "Diseño e impresión 3D..." },
    { id: "music", name: "Music", icon: "mdi:music", description: "Tecnología sonora..." }
];

const projectCategories = baseCategories.map(cat => ({
    ...cat,
    count: allProjects.filter(p => p.data.category.toLowerCase() === cat.id).length
}));

const stats = {
	projects: allProjects.length,
	categories: projectCategories.length,
	community: 2300
};


---

<Layout title="Geekeando | Arduino, 3D Print & Papercraft">
    <HeroSection />

    <section class="py-12 border-b border-neutral-800 bg-neutral-950/50">
        <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-800">
                <div class="text-center p-6 group">
                    <p class="glitch-hover text-4xl font-display font-bold text-amber-500 transition-transform group-hover:scale-110">{stats.projects}+</p>
                    <p class="mt-2 text-[10px] font-mono uppercase tracking-[0.3em] text-neutral-600">Proyectos</p>
                </div>
                <div class="text-center p-6 group">
                    <p class="glitch-hover text-4xl font-display font-bold text-blue-400 transition-transform group-hover:scale-110">{stats.categories}</p>
                    <p class="mt-2 text-[10px] font-mono uppercase tracking-[0.3em] text-neutral-600">Labs</p>
                </div>
                <div class="text-center p-6 group">
                    <p class="glitch-hover text-4xl font-display font-bold text-emerald-400 transition-transform group-hover:scale-110">{stats.community}+</p>
                    <p class="mt-2 text-[10px] font-mono uppercase tracking-[0.3em] text-neutral-600">Makers</p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-16 relative overflow-hidden bg-neutral-950">
		<div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(#333 1px, transparent 1px), linear-gradient(90deg, #333 1px, transparent 1px); background-size: 40px 40px;"></div>
	
		<div class="relative z-10 mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row justify-between items-center gap-6 mb-12 border-b border-neutral-900 pb-8">
				<div>
					<h2 class="text-2xl font-display font-bold text-white uppercase tracking-tighter sm:text-3xl">
						Proyectos <span class="text-amber-500">_Destacados</span>
					</h2>
					<p class="text-neutral-500 mt-2 font-mono text-[10px] uppercase tracking-widest">// status: featured_selection_active</p>
				</div>
				
				<a href="/projects" class="group flex items-center gap-2 px-4 py-2 bg-neutral-900/50 border border-neutral-800 rounded text-[10px] font-mono text-amber-500 hover:border-amber-500/50 transition-all">
					<span class="tracking-widest">[ VER_REPOS_FULL ]</span>
					<Icon name="mdi:chevron-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
				</a>
			</div>
	
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{finalProjects.map((project, index) => (
					<a href={`/projects/${project.data.category.toLowerCase()}/${project.slug}`} 
					   class="group relative flex flex-col h-full rounded-xl border border-neutral-800 bg-neutral-900/40 overflow-hidden hover:border-amber-500/50 transition-all duration-500">

						{/* Badge Técnico */}
						<div class="absolute top-4 right-4 z-20">
							<span class="text-[8px] font-mono font-bold px-2 py-1 rounded bg-neutral-950 border border-amber-500/30 text-amber-500">
								DATA_ID: {project.data.difficulty?.toUpperCase()}
							</span>
						</div>
							
						<div class="relative aspect-video overflow-hidden border-b border-neutral-800">
							<img
								src={project.data.image.src}
								alt={project.data.title}
								class="h-full w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
							/>
						</div>
	
						<div class="p-6 flex flex-col flex-grow">
							<span class="text-[9px] font-mono text-amber-500/50 mb-2">CATEGORY::{project.data.category.toUpperCase()}</span>
							<h3 class="text-xl font-display font-bold text-white mb-2 group-hover:text-amber-500 transition-colors">
								{project.data.title}
							</h3>
							<p class="text-sm text-neutral-500 font-light line-clamp-2 mb-6">
								{project.data.description}
							</p>
	
							<div class="mt-auto pt-4 border-t border-neutral-800/50 flex justify-between items-center text-[10px] font-mono text-neutral-600">
								<span>TIMESTAMP: {project.data.pubDate.toLocaleDateString('es-ES', { year: '2-digit', month: '2-digit' })}</span>
								<Icon name="mdi:arrow-right" class="h-4 w-4 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-amber-500" />
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

    <section class="py-16 relative overflow-hidden bg-neutral-950">
        <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(#333 1px, transparent 1px), linear-gradient(90deg, #333 1px, transparent 1px); background-size: 40px 40px;"></div>
        
        <div class="relative z-10 mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-2xl font-display font-bold text-white uppercase tracking-widest sm:text-3xl">Explora los Labs</h2>
                <div class="mt-2 h-1 w-20 bg-amber-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {projectCategories.map((category) => (
                    <a href={`/projects/${category.id}`} class="group p-8 rounded-2xl border border-neutral-800 bg-neutral-900/60 backdrop-blur-md hover:border-amber-500/40 transition-all hover:-translate-y-2">
                        <div class="mb-4 inline-flex items-center justify-center rounded-xl bg-amber-500/10 p-3 text-amber-500 group-hover:bg-amber-500 group-hover:text-neutral-900 transition-all duration-300">
                            <Icon name={category.icon} class="h-8 w-8" />
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-amber-500 transition-colors">{category.name}</h3>
                        <div class="flex items-center gap-2 mb-4">
							<span class="glitch-hover text-[10px] px-2 py-0.5 rounded bg-neutral-800 text-amber-500 font-mono border border-neutral-700 cursor-default">
								{(category.count || 0).toString().padStart(2, '0')} UNITS
							</span>
							<div class="h-px flex-1 bg-neutral-800"></div>
						</div>
                        <p class="text-sm text-neutral-400 line-clamp-2 font-light">{category.description}</p>
                    </a>
                ))}
            </div>
        </div>
    </section>
	<section class="py-20 bg-neutral-950">
		<div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
			<div class="flex items-center gap-4 mb-12">
				<h2 class="text-xl font-display font-bold text-white uppercase tracking-tighter">
					Últimas Entradas <span class="text-amber-500">.log</span>
				</h2>
				<div class="h-px flex-1 bg-neutral-900"></div>
				<a href="/blog" class="text-[10px] font-mono text-neutral-500 hover:text-amber-500 uppercase tracking-widest transition-colors">
					Ver todo_el_archivo [++]
				</a>
			</div>
	
			<div class="grid gap-8 lg:grid-cols-3">
				{latestPosts.map((post) => (
					<article class="group relative flex flex-col bg-neutral-900/20 border border-neutral-800 rounded-xl p-6 hover:bg-neutral-900/40 transition-all duration-300">
						<div class="flex justify-between items-start mb-4">
							<span class="text-[9px] font-mono text-amber-500/60 uppercase tracking-widest">
								[{post.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}]
							</span>
							<Icon name="mdi:text-box-outline" class="h-4 w-4 text-neutral-700 group-hover:text-amber-500 transition-colors" />
						</div>
						
						<h3 class="text-lg font-bold text-neutral-200 group-hover:text-white mb-3 leading-tight">
							<a href={post.url}>
								{post.title}
							</a>
						</h3>
						
						<p class="text-sm text-neutral-500 font-light line-clamp-2 mb-6">
							{post.description}
						</p>
	
						<div class="mt-auto pt-4 border-t border-neutral-800/50 flex justify-between items-center">
							<span class="text-[10px] font-mono text-neutral-600 italic">
								{post.author || 'Pedro Carranza'}
							</span>
							<a href={post.url} class="text-[10px] font-mono text-amber-500 opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0 uppercase">
								Leer_más >>
							</a>
						</div>
						<div class="buffer-bar"></div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>
<style>
    /* ... tus estilos anteriores ... */
	.buffer-bar {
		position: absolute;
		bottom: 0;
		left: 0;
		height: 2px;
		width: 0;
		background: #f59e0b;
		transition: width 0.5s ease;
		box-shadow: 0 0 10px #f59e0b;
	}

	article:hover .buffer-bar {
		width: 100%;
	}
    .glitch-hover:hover {
        animation: glitch 0.3s cubic-bezier(.25, .46, .45, .94) both infinite;
        text-shadow: 0 0 8px rgba(245, 158, 11, 0.8);
    }

    @keyframes glitch {
        0% { transform: translate(0); }
        20% { transform: translate(-2px, 2px); }
        40% { transform: translate(-2px, -2px); }
        60% { transform: translate(2px, 2px); }
        80% { transform: translate(2px, -2px); }
        100% { transform: translate(0); }
    }

    .font-display { font-family: 'Orbitron', sans-serif; }
	.line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>