---
import Layout from "@/layouts/Layout.astro"
import TitleSection from "@/components/ui/TitleSection.astro"
import SinglePost from "@/components/ui/post/SinglePost.astro"
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
    title?: string;
    pubDate?: string;
    description?: string;
    author?: string;
    image?: {
        url?: string;
        alt?: string;
    };
    tags?: string[];
}

const allPostsFile = import.meta.glob<MarkdownInstance<Frontmatter>>('@posts/*.md',{ eager: true });
// const allPosts = Object.values(allPostsFile);

const allPosts = Object.entries(allPostsFile).map(([filePath, post]) => {
    const flatPost = Object.assign({}, post);
    const slug = filePath.replace('/src/pages/posts/', '').replace('.md', '');
    const url = `/posts/${slug}`;
    return {
        ...flatPost, // Incluye el contenido del módulo
        url: url, // Convierte el nombre del archivo en una URL
    };
});

// Removed deprecated Astro.glob usage
const allTags = Object.values(allPostsFile).map((post: MarkdownInstance<Frontmatter>) => post.frontmatter.tags || []).flat();
const tagCounts = allTags.reduce((acc: Record<string, number>, tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
}, {} as Record<string, number>);
const tags = Object.keys(tagCounts);
const title: string = "Blog Geekeando";
const subTitle: string = "Descubre artículos sobre tecnología, gaming y cultura geek";
const arrowSVG: string = `<svg
class="h-4 w-4 flex-shrink-0 transition ease-in-out group-hover:translate-x-1"
fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" >
<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /> </svg>`;
---
<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="mx-auto max-w-2xl lg:max-w-5xl mb-12 text-center">
            <TitleSection
                title={ title }
                subTitle={ subTitle }
            />
            <!-- Filtros por categoría -->
            <div class="mt-6 flex flex-wrap justify-center gap-3">
                <button class="filter-btn active">
                    <a href="/blog">Todos</a>
                </button>
                {
                    tags.map((tag) => (
                    <button class="filter-btn">
                        <a href={`/tags/${tag}`}>
                            {tag}
                        </a>
                    </button>
                    ))
                }
            </div>
        </div>
        <div class="space-y-8">
                {allPosts.map((post, index) => (
                    <SinglePost
                        icon = { '' }
                        title = { (post.frontmatter as Frontmatter)?.title || "Sin Titulo" }
                        text = { (post.frontmatter as Frontmatter)?.description }
                        link = { {href:post.url,text:"Continuar Leyendo"} }
                        tags = { (post.frontmatter as Frontmatter)?.tags }
                        pubDate = { (post.frontmatter as Frontmatter)?.pubDate }
                        author = { (post.frontmatter as Frontmatter)?.author }
                        svg = { arrowSVG }
                        image = { (post.frontmatter as Frontmatter)?.image }
                        key = { index }
                    />
                ))}
        </div>
        <!-- Paginación (Opcional) -->
        <div class="mt-12 flex justify-center gap-2">
            <button class="pagination-btn disabled" disabled>
                Anterior
            </button>
            <button class="pagination-btn active">1</button>
            <button class="pagination-btn">2</button>
            <button class="pagination-btn">Siguiente</button>
        </div>
    </section>
    <style>
        @reference '../styles/global.css';

        /* Estilos para los filtros */
        .filter-btn {
            @apply rounded-full px-4 py-2 text-sm font-medium bg-neutral-800 text-neutral-300 hover:bg-amber-400/10 hover:text-amber-400 transition-colors;
        }
        .filter-btn.active {
            @apply bg-amber-500/20 text-amber-400;
        }
        /* Estilos para paginación */
        .pagination-btn {
            @apply rounded-lg px-4 py-2 bg-neutral-800 text-neutral-300 hover:bg-amber-500 hover:text-neutral-900 transition-colors;
        }
        .pagination-btn.active {
            @apply bg-amber-500 text-neutral-900;
        }
        .pagination-btn.disabled {
            @apply opacity-50 cursor-not-allowed;
        }
    </style>
</Layout>