---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from "@layouts/Layout.astro";
import ProjectHeader from "@/components/ui/projects/ProjectHeader.astro";
import MaterialsList from "@/components/ui/projects/MaterialsList.astro";
import StepByStep from "@/components/ui/projects/StepByStep.astro";
import ProjectGallery from "@/components/ui/projects/ProjectGallery.astro";
import RelatedProjects from "@/components/ui/projects/RelatedProjects.astro";
import Breadcrumbs from "@/components/ui/projects/Breadcrumbs.astro";
import DownloadsSection from "@/components/ui/projects/DownloadsSection.astro";
import ProjectsTips from '@/components/ui/projects/ProjectsTips.astro';
import { Icon } from 'astro-icon/components';

// 1. Generar rutas dinámicas desde la carpeta src/content/projects/
export async function getStaticPaths() {
    const projectEntries = await getCollection('projects');
    return projectEntries.map((entry) => {
        // Limpiamos la categoría para evitar errores de formato
        const catParam = entry.data.category.toLowerCase().trim();
        return {
            params: { 
                category: catParam, 
                project: entry.slug 
            },
            props: { entry },
        };
    });
}

const { entry } = Astro.props;
const { title, author, image } = entry.data;
// CONTROL DE SEGURIDAD: Si no hay entry, redirigir o mostrar error
if (!entry) {
    return Astro.redirect('/404');
}
const { Content } = await entry.render();
const projectData = entry.data;
const { stlLink, codeRepo } = projectData;
const { gallery } = entry.data;
const { category } = entry.data;
const { steps } = entry.data;
// Obtener todos los proyectos de la misma categoría
const allProjects = await getCollection('projects');
const relatedProjects = allProjects
  .filter(p => p.data.category === category && p.slug !== entry.slug)
  .slice(0, 3); // Solo mostramos los 3 más recientes
// Mapeo de colores por dificultad (Estilo Geek)
const diffColors = {
    Principiante: "text-emerald-400 border-emerald-800 bg-emerald-950/30",
    Intermedio: "text-amber-400 border-amber-800 bg-amber-950/30",
    Avanzado: "text-red-400 border-red-800 bg-red-950/30"
};

// Mapeamos los links individuales a la estructura de lista
const downloadFiles = [
  stlLink && { name: "DISEÑO_3D_CHASIS", type: "STL", link: stlLink, size: "2.4MB" },
  codeRepo && { name: "CONTROL_SISTEMA_INO", type: "INO", link: codeRepo }
].filter(Boolean);

---

<Layout title={`${projectData.title} | Geekeando`}>
    <article class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 bg-neutral-950">
        <Breadcrumbs 
        category={projectData.category} 
        title={projectData.title} 
        />
        <ProjectHeader
            title={projectData.title}
            category={projectData.category}
            difficulty={projectData.difficulty}
            date={projectData.pubDate.toDateString()}
            description={projectData.description}
            coverImage={projectData.image}
            tags={projectData.tags}
            author={projectData.author}
        />

        <div class="lg:grid lg:grid-cols-12 lg:gap-8 mt-12">
            <div class="lg:col-span-8 space-y-12">
                {projectData.verified && (
                <div class="flex items-center gap-4 p-4 rounded-xl border border-amber-500/20 bg-amber-500/5 group hover:border-amber-500/40 transition-colors">
                    <div class="relative">
                        <img src="/geekeando.svg" class="h-10 w-10 grayscale group-hover:grayscale-0 transition-all relative z-10" alt="Bitsa Core" />
                        <div class="absolute inset-0 bg-amber-500/20 blur-xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    </div>
                    <div>
                        <p class="text-xs font-mono text-amber-500 font-bold uppercase tracking-widest">BitsaBots Verified Core</p>
                        <p class="text-[11px] text-neutral-400 leading-tight">Este proyecto ha sido testeado en nuestro laboratorio físico.</p>
                    </div>
                </div>
                )}
                <div class="mt-8">
                    {gallery.length > 0 && <ProjectGallery images={gallery} />}
                    {steps && steps.length > 0 && (
                        <section class="mt-20 max-w-4xl">
                            <h2 class="text-xs font-mono text-amber-500 uppercase tracking-[0.4em] mb-12 flex items-center gap-3">
                                <Icon name="mdi:hammer-wrench" class="h-4 w-4" />
                                Guía de Ensamblaje [.build]
                            </h2>
                            <div class="flex flex-col">
                                {steps.map((step, index) => (
                                    <StepByStep 
                                        {...step} 
                                        isLast={index === steps.length - 1} 
                                    />
                                ))}
                            </div>
                        </section>
                    )}
                    <ProjectsTips tips={projectData.tips} />
                    {relatedProjects.length > 0 && (
                        <section class="mt-20 border-t border-neutral-800 pt-10">
                          <div class="flex items-center justify-between mb-8">
                            <h3 class="text-xs font-mono text-amber-500 uppercase tracking-[0.3em] flex items-center gap-2">
                              <span class="w-2 h-2 bg-amber-500 rounded-full"></span>
                              Proyectos Similares [.rel]
                            </h3>
                            <a href={`/projects/${category.toLowerCase()}`} class="text-[10px] font-mono text-neutral-500 hover:text-amber-500 transition-colors">
                              VER_TODO_{category.toUpperCase()} ->
                            </a>
                          </div>
                          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {relatedProjects.map((project) => (
                              <RelatedProjects 
                                projects={relatedProjects}
                                currentCategory={category}
                              />
                            ))}
                          </div>
                        </section>
                      )}
                </div>
            </div>
            
            <aside class="lg:col-span-4 space-y-8">
                
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 backdrop-blur-sm">
                    <h3 class="font-display text-lg font-bold text-white mb-4 flex items-center gap-2">
                        <Icon name="mdi:format-list-bulleted-type" class="h-5 w-5 text-amber-500" />
                        LISTA DE MATERIALES
                    </h3>
                    <MaterialsList items={projectData.materials || []} />
                    
                </div>

                <section class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6">
                    <div class="space-y-4">
                        <div class="flex items-center gap-2 text-amber-500 font-mono text-xs uppercase tracking-tighter">
                            <Icon name="mdi:folder-download" class="h-4 w-4" />
                            Recursos [.root]
                        </div>
                    
                        <div class="grid gap-2">
                            {downloadFiles.length > 0 && <DownloadsSection files={downloadFiles} />}
                        </div>
                    </div>
                </section>

                <section class="rounded-2xl border border-neutral-800 bg-amber-500/5 p-6">
                    <p class="text-xs font-mono text-amber-500 mb-4 uppercase tracking-widest text-center">Difundir Conocimiento</p>
                    <div class="grid grid-cols-2 gap-2">
                        <button class="flex items-center justify-center gap-2 py-2 rounded-lg bg-neutral-900 border border-neutral-800 text-xs text-neutral-400 hover:text-white transition-colors">
                            <Icon name="mdi:twitter" class="h-4 w-4" /> Twitter
                        </button>
                        <button class="flex items-center justify-center gap-2 py-2 rounded-lg bg-neutral-900 border border-neutral-800 text-xs text-neutral-400 hover:text-white transition-colors">
                            <Icon name="mdi:content-copy" class="h-4 w-4" /> Enlace
                        </button>
                    </div>
                </section>
            </aside>
        </div>
    </article>
</Layout>

<style is:global>
    /* Estilo para que el contenido Markdown se vea Geek */
    .prose pre {
        background-color: #0a0a0a !important;
        border: 1px solid #262626;
        border-radius: 12px;
    }
    .prose h2, .prose h3 {
        font-family: 'Orbitron', sans-serif;
        letter-spacing: -0.05em;
    }
    .prose blockquote {
    border-left: 4px solid #f59e0b; /* Amber 500 */
    background: rgba(245, 158, 11, 0.05);
    padding: 1rem;
    font-style: italic;
    border-radius: 0 0.5rem 0.5rem 0;
}
</style>