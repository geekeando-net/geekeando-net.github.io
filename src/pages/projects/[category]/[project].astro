---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from "@layouts/Layout.astro";
import ProjectHeader from "@/components/ui/projects/ProjectHeader.astro";
import MaterialsList from "@/components/ui/projects/MaterialsList.astro";
import StepByStep from "@/components/ui/projects/StepByStep.astro";
import ProjectGallery from "@/components/ui/projects/ProjectGallery.astro";
import RelatedProjects from "@/components/ui/projects/RelatedProjects.astro";
import Breadcrumbs from "@/components/ui/projects/Breadcrumbs.astro";
import DownloadsSection from "@/components/ui/projects/DownloadsSection.astro";
import ProjectsTips from '@/components/ui/projects/ProjectsTips.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
    const projectEntries = await getCollection('projects');
    return projectEntries.map((entry) => ({
        params: { 
            category: entry.data.category.toLowerCase().trim(), 
            project: entry.id
        },
        props: { entry },
    }));
}

const { entry } = Astro.props;

if (!entry) return Astro.redirect('/404');

const pData = entry.data;

// Obtener proyectos relacionados (misma categoría, distinto slug)
const allProjects = await getCollection('projects');
const relatedProjects = allProjects
    .filter(p => p.data.category === pData.category && p.id !== entry.id)
  .slice(0, 3);

// Lógica de descargas dinámica
// Si tienes archivos específicos en el frontmatter, los mapeamos
const dynamicDownloads = pData.downloadFiles?.map(file => ({
    name: file.name,
    type: file.type || file.file.split('.').pop()?.toUpperCase(),
    link: file.file, // Astro resolverá esta ruta relativa
    size: "DETECTOR_PENDIENTE" // Opcional: podrías añadir el tamaño manualmente en el MD
})) || [];

// Mantenemos tus links externos si existen (STL o Repo)
const externalLinks = [
  pData.stlLink && { name: "DISEÑO_3D_EXTERNO", type: "STL", link: pData.stlLink },
  pData.codeRepo && { name: "GITHUB_REPOSITORY", type: "GIT", link: pData.codeRepo }
].filter(Boolean);

const allDownloads = [...dynamicDownloads, ...externalLinks];
---

<Layout title={`${pData.title} | Geekeando Labs`}>
    <article class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 bg-neutral-950 font-mono">
        
        <Breadcrumbs category={pData.category} title={pData.title} />

        <ProjectHeader
            title={pData.title}
            category={pData.category}
            difficulty={pData.difficulty}
            date={pData.pubDate.toDateString()}
            description={pData.description}
            coverImage={pData.image} 
            tags={pData.tags}
            author={pData.author}
        />

        <div class="lg:grid lg:grid-cols-12 lg:gap-12 mt-16">
            <div class="lg:col-span-8 space-y-16">
                
                {/* Badge de Verificación */}
                {pData.verified && (
                    <div class="flex items-center gap-5 p-5 border border-amber-500/20 bg-amber-500/5 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-1 bg-amber-500 text-[8px] font-black text-black tracking-tighter">VERIFIED_LOG</div>
                        <Icon name="mdi:check-decagram" class="h-8 w-8 text-amber-500 animate-pulse" />
                        <div>
                            <p class="text-xs font-bold text-amber-500 uppercase tracking-[0.2em]">BitsaBots Lab Tested</p>
                            <p class="text-[11px] text-neutral-500 font-sans">Hardware y firmware validados en entorno físico controlado.</p>
                        </div>
                    </div>
                )}

                {/* Galería (Page Bundle) */}
                {pData.gallery && pData.gallery.length > 0 && (
                    <section>
                        <h2 class="text-[10px] text-neutral-600 mb-6 flex items-center gap-2 italic">
                            <span class="w-8 h-px bg-neutral-800"></span> VISUAL_ASSETS
                        </h2>
                        <ProjectGallery images={pData.gallery} />
                    </section>
                )}

                {/* Guía de Ensamblaje */}
                {pData.steps && pData.steps.length > 0 && (
                    <section class="pt-12 border-t border-neutral-900">
                        <h2 class="text-xs font-bold text-amber-500 uppercase tracking-[0.4em] mb-12 flex items-center gap-3">
                            <Icon name="mdi:hammer-wrench" class="h-5 w-5" />
                            Build_Sequence [.v1]
                        </h2>
                        <div class="space-y-4">
                            {pData.steps.map((step, index) => (
                                <StepByStep
                                    {...step}
                                    isLast={index === (pData.steps?.length ?? 0) - 1} 
                                />
                            ))}
                        </div>
                    </section>
                )}

                <ProjectsTips tips={pData.tips} />

                {/* Proyectos Relacionados */}
                {relatedProjects.length > 0 && (
                    <section class="pt-16 border-t border-neutral-900">
                        <div class="flex items-center justify-between mb-10">
                            <h3 class="text-xs font-bold text-neutral-400 uppercase tracking-[0.3em]">Project_Relacionado</h3>
                            <a href={`/projects/${pData.category.toLowerCase()}`} class="text-[9px] text-amber-500/50 hover:text-amber-500 transition-colors">
                                VER_DIRECTORIO_COMPLETO ->
                            </a>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {relatedProjects.map((p) => (
                                <RelatedProjects project={p} currentCategory={pData.category}/> 
                            ))}
                        </div>
                    </section>
                )}
            </div>
            
            <aside class="lg:col-span-4 space-y-8">
                <div class="sticky top-24 space-y-8">
                    
                    <div class="border border-neutral-800 bg-neutral-900/20 p-8">
                        <h3 class="text-xs font-black text-white mb-6 flex items-center gap-2 tracking-widest">
                            <Icon name="mdi:memory" class="h-4 w-4 text-amber-500" />
                            BOM_LIST
                        </h3>
                        <MaterialsList items={pData.materials || []} />
                    </div>

                    <section class="border border-neutral-800 bg-black/40 p-8 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-16 h-16 bg-amber-500/5 -rotate-45 translate-x-8 -translate-y-8"></div>
                        <h3 class="text-xs font-black text-white mb-6 flex items-center gap-2 tracking-widest">
                            <Icon name="mdi:cloud-download" class="h-4 w-4 text-amber-500" />
                            DOWNLOAD_CENTER
                        </h3>
                        <DownloadsSection files={allDownloads} />
                    </section>

                    <section class="p-6 border border-neutral-900">
                        <div class="flex justify-between gap-4">
                            <button class="flex-grow flex items-center justify-center gap-2 py-3 border border-neutral-800 text-[10px] uppercase text-neutral-500 hover:text-amber-500 hover:border-amber-500 transition-all">
                                <Icon name="mdi:share-variant" /> Share
                            </button>
                            <button class="flex-grow flex items-center justify-center gap-2 py-3 border border-neutral-800 text-[10px] uppercase text-neutral-500 hover:text-amber-500 hover:border-amber-500 transition-all">
                                <Icon name="mdi:link-variant" /> Copy
                            </button>
                        </div>
                    </section>
                </div>
            </aside>
        </div>
    </article>
</Layout>