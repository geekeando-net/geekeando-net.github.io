---
// src/pages/proyectos/[category]/index.astro
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import { Icon } from 'astro-icon/components';

// Obtener la categoría de los parámetros de la ruta
const { category } = Astro.params;
const imagesBanner = import.meta.glob('../../../../src/assets/images/categories/*.{jpg,png,webp,avif}');
const getImageBannerUrl = async (imagePath: string) => {
    if (!imagePath) return null;
    const imageFileName = imagePath.split('/').pop() ?? 'default.png';
    const imageKey = Object.keys(imagesBanner).find((key) => key.endsWith(imageFileName));
    if (imageKey) {
        try {
            const module = await imagesBanner[imageKey]();
            return (module as { default: string }).default;
        } catch (e) {
            console.error(`Error cargando la imagen: ${imageKey}`, e);
            return null;
        }
    }else{
        try {
            const imageDefault = Object.keys(imagesBanner).find((key) => key.endsWith('default.png'));
            if (imageDefault) {
                const module = await imagesBanner[imageDefault]();
                return (module as { default: any }).default;
            }
            return null;
        } catch (e) {
            console.error(`Error cargando la imagen por defecto`, e);
            return null;
        }
    }
    return null;
};
// Datos de ejemplo (en producción vendrían de una API o CMS)
const categoryData = {
    "arduino": {
        name: "Arduino",
        description: "Proyectos de automatización y electrónica con Arduino",
        icon: "mdi:chip",
        banner: "../../../assets/images/categories/arduino-bg.png",
        projects: [
            {
                slug: "riego-automatico",
                title: "Sistema de Riego Automático",
                image: "../../../src/assets/images/projects/arduino-irrigation.png",
                tags: ["IoT", "Jardinería"],
                date: "2023-10-15",
                difficulty: "Intermedio"
            },
        // ... más proyectos
        ]
    }
  // ... otras categorías
};

const currentCategory = categoryData[category as keyof typeof categoryData] || categoryData.arduino;
const imageCategoryBanner = await getImageBannerUrl(currentCategory.banner);

const difficultyColors = {
    Principiante: "bg-green-900/50 text-green-400 border-green-800",
    Intermedio: "bg-amber-900/50 text-amber-400 border-amber-800",
    Avanzado: "bg-red-900/50 text-red-400 border-red-800"
};
---

<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="text-sm text-neutral-500 mb-6">
            <a href="/projects" class="hover:text-purple-400">Projects</a>
            <span class="mx-2">/</span>
            <span class="text-purple-400">{currentCategory.name}</span>
        </div>
        <div class="relative rounded-xl overflow-hidden border border-neutral-800 mb-12">
            <div style={`background-image: url('${imageCategoryBanner?.src}')`} class="aspect-[16/5] w-full bg-neutral-900 bg-cover bg-center">
                <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/20 to-transparent">
                </div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-center">
                    <h1 class="text-4xl font-bold text-neutral-100">{currentCategory.name}</h1>
                    <p class="text-lg text-neutral-300 mt-2 max-w-2xl mx-auto">{currentCategory.description}</p>
                </div>
            </div>
        </div>
    <!-- Encabezado de categoría -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
        <div>
            <span class="inline-flex items-center gap-2 text-purple-400 mb-2">
            <Icon name={currentCategory.icon} class="h-5 w-5" />
            Categoría
            </span>
            <h1 class="text-3xl sm:text-4xl font-bold text-neutral-100">{currentCategory.name}</h1>
            <p class="text-lg text-neutral-400 mt-2">{currentCategory.description}</p>
        </div>
        <div class="flex gap-3">
            <button class="flex items-center gap-2 rounded-lg border border-neutral-700 px-4 py-2 text-neutral-300 hover:bg-neutral-800 transition-colors">
            <Icon name="mdi:sort" class="h-5 w-5" />
            Ordenar
            </button>
            <button class="flex items-center gap-2 rounded-lg border border-neutral-700 px-4 py-2 text-neutral-300 hover:bg-neutral-800 transition-colors">
            <Icon name="mdi:filter" class="h-5 w-5" />
            Filtrar
            </button>
        </div>
    </div>

    <!-- Filtros activos (opcional) -->
    <div class="flex flex-wrap gap-3 mb-8">
        <span class="inline-flex items-center gap-2 rounded-full border bg-amber-900/50 text-amber-400 border-amber-800 bg-neutral-800 px-3 py-1 text-sm">
            Dificultad: Intermedio
            <button class="text-neutral-400 hover:text-neutral-200">
            <Icon name="mdi:close" class="h-4 w-4" />
            </button>
        </span>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {currentCategory.projects.map((project) => (
            <a
            href={`/projects/${category}/${project.slug}`}
            class="block hover:no-underline"
            >
            <ProjectCard
                title={project.title}
                image={project.image}
                category={currentCategory.name}
                tags={project.tags}
                date={project.date}
                difficulty={project.difficulty}
            />
            </a>
        ))}
    </div>

    <!-- Paginación -->
    <div class="mt-12 flex justify-center gap-2">
      <button class="flex items-center justify-center h-10 w-10 rounded-lg border border-neutral-700 text-neutral-400 hover:bg-neutral-800">
        <Icon name="mdi:chevron-left" class="h-5 w-5" />
      </button>
      <button class="flex items-center justify-center h-10 w-10 rounded-lg bg-purple-500 text-neutral-100 font-medium">
        1
      </button>
      <button class="flex items-center justify-center h-10 w-10 rounded-lg border border-neutral-700 text-neutral-400 hover:bg-neutral-800">
        2
      </button>
      <button class="flex items-center justify-center h-10 w-10 rounded-lg border border-neutral-700 text-neutral-400 hover:bg-neutral-800">
        <Icon name="mdi:chevron-right" class="h-5 w-5" />
      </button>
    </div>
  </section>
</Layout>