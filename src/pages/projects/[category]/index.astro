---
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const { category } = Astro.params;

if (!category) {
    return Astro.redirect('/projects');
}
// 1. Obtener proyectos filtrados por categoría
const allProjects = await getCollection('projects', ({ data }) => {
    return data.category.toLowerCase() === category?.toLowerCase();
});

if (allProjects.length === 0 && category !== 'all') {
    return Astro.redirect('/404');
}

// 2. Cargar Banner
const imagesBanner = import.meta.glob('/src/assets/images/categories/*.{jpg,png,webp,avif}');
const categoryKey = Object.keys(imagesBanner).find(key => key.includes(category || 'default'));
const bannerImage = categoryKey ? (await (imagesBanner[categoryKey]() as any)).default : null;

const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
---

<Layout title={`Proyectos de ${categoryName} | Geekeando`}>
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        
        <nav class="flex items-center text-[10px] font-mono uppercase tracking-[0.2em] mb-8 bg-neutral-900/50 w-fit p-2 rounded border border-neutral-800">
            <a href="/" class="text-neutral-500 hover:text-amber-500 transition-colors">ROOT</a>
            <span class="mx-2 text-neutral-700">/</span>
            <span class="text-amber-500">{category}.DIR</span>
        </nav>

        <div class="relative rounded-2xl overflow-hidden border border-neutral-800 mb-16 group">
            <div class="aspect-[21/9] md:aspect-[16/5] w-full bg-neutral-900 relative">
                {bannerImage && (
                    <Image 
                        src={bannerImage} 
                        alt={categoryName} 
                        class="w-full h-full object-cover opacity-40 grayscale group-hover:grayscale-0 transition-all duration-700"
                    />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent"></div>
                <div class="absolute inset-0 flex flex-col items-center justify-center p-8">
                    <h1 class="text-4xl md:text-6xl font-black text-neutral-100 uppercase tracking-tighter italic">
                        {categoryName}
                    </h1>
                    <p class="text-[10px] font-mono text-amber-500/70 mt-4 tracking-[0.3em]">
                        DATA_COLLECTION: {allProjects.length} UNITS_FOUND
                    </p>
                </div>
            </div>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-center gap-6 mb-12 pb-6 border-b border-neutral-800">
            <div class="flex gap-4">
                <button class="text-[10px] font-mono px-4 py-2 border border-neutral-800 rounded hover:border-amber-500 transition-colors flex items-center gap-2">
                    <Icon name="mdi:sort-variant" class="h-4 w-4" /> SORT_BY: DATE
                </button>
            </div>

            <div class="relative w-full md:w-80 group search-terminal">
                <Icon 
                    name="mdi:magnify" 
                    class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-500 group-focus-within:text-amber-500 group-focus-within:animate-pulse transition-colors" 
                />
                <input 
                    type="text" 
                    id="project-search"
                    placeholder={`SEARCH_IN_${category?.toUpperCase()}...`}
                    class="w-full bg-neutral-900/40 border border-neutral-800 rounded py-2.5 pl-10 pr-4 text-[11px] font-mono text-neutral-200 focus:outline-none focus:border-amber-500/50 focus:ring-1 focus:ring-amber-500/10 transition-all placeholder:text-neutral-700"
                />
                <div class="absolute -bottom-5 left-1 hidden group-focus-within:block">
                    <span class="text-[7px] font-mono text-amber-500/50 uppercase tracking-[0.2em] animate-pulse">
                        > Scanning_database...
                    </span>
                </div>
            </div>
        </div>

        <div id="projects-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {allProjects.map((project) => (
                <div class="project-item" data-title={project.data.title.toLowerCase()} data-tags={project.data.tags?.join(' ').toLowerCase()}>
                    <ProjectCard
                        project={project}
                    />
                </div>
            ))}
        </div>

        <div id="no-results" class="hidden mt-20 text-center py-20 border border-dashed border-neutral-800 rounded-2xl">
            <Icon name="mdi:database-off-outline" class="h-10 w-10 text-neutral-800 mx-auto mb-4" />
            <p class="font-mono text-[10px] text-neutral-600 uppercase tracking-widest italic">
                [!] Error: No matches found for the current query
            </p>
        </div>
    </section>
</Layout>
<style>
    /* Efecto de parpadeo de borde para el buscador */
    .search-terminal input:focus {
        animation: border-glitch 2s infinite;
    }

    @keyframes border-glitch {
        0%, 100% { border-color: rgba(245, 158, 11, 0.5); }
        50% { border-color: rgba(245, 158, 11, 0.2); }
        51% { border-color: rgba(255, 255, 255, 0.5); }
        52% { border-color: rgba(245, 158, 11, 0.5); }
    }

    /* Estilo para el placeholder */
    input::placeholder {
        transition: opacity 0.3s ease;
    }

    input:focus::placeholder {
        opacity: 0.3;
    }
</style>
<script>
    // Lógica de filtrado en tiempo real
    const searchInput = document.getElementById('project-search') as HTMLInputElement;
    const projectItems = document.querySelectorAll('.project-item');
    const noResults = document.getElementById('no-results');
    const grid = document.getElementById('projects-grid');

    searchInput?.addEventListener('input', (e) => {
        const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
        let found = false;

        projectItems.forEach((item) => {
            const title = item.getAttribute('data-title') || '';
            const tags = item.getAttribute('data-tags') || '';
            
            if (title.includes(searchTerm) || tags.includes(searchTerm)) {
                (item as HTMLElement).style.display = 'block';
                found = true;
            } else {
                (item as HTMLElement).style.display = 'none';
            }
        });

        if (noResults && grid) {
            if (!found) {
                noResults.classList.remove('hidden');
                grid.classList.add('opacity-20'); // Efecto de "apagado" al fondo
            } else {
                noResults.classList.add('hidden');
                grid.classList.remove('opacity-20');
            }
        }
    });
</script>