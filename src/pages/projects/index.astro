---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import { Icon } from "astro-icon/components";

const title = "Proyectos [.root]";
const subTitle = "Laboratorio de ingeniería, diseño y manualidades técnicas";

// 1. Obtenemos la colección completa (Astro procesa las imágenes automáticamente)
const allProjects = await getCollection("projects");

// 2. Definimos las categorías
const categories = [
    { id: "arduino", name: "Arduino", icon: "mdi:chip", desc: "Electrónica y código" },
    { id: "papercraft", name: "Paper Craft", icon: "mdi:paper-cut-vertical", desc: "Ingeniería en papel" },
    { id: "3d-print", name: "3D Print", icon: "mdi:printer-3d", desc: "Prototipado aditivo" },
    { id: "music", name: "Music", icon: "mdi:music", desc: "Tecnología sonora" }
];

// 3. Agrupamos los objetos de proyecto enteros por categoría
const projectsByCategory = categories.map(cat => ({
    ...cat,
    projects: allProjects.filter(p => p.data.category.toLowerCase() === cat.id)
}));
---

<Layout title="Geekeando | Repositorio de Proyectos">
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 bg-neutral-950 font-mono">
        
        <div class="mx-auto max-w-4xl text-center mb-16 relative">
            <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(#fbbf24 1px, transparent 1px); background-size: 20px 20px;"></div>
            <TitleSection
                title={title}
                subTitle={subTitle}
                accentColor="amber" 
            />
        </div>

        <div class="sticky top-16 z-20 bg-neutral-950/95 backdrop-blur-md py-4 mb-12 border-b border-neutral-800">
            <div class="flex items-center gap-4 overflow-x-auto no-scrollbar pb-2">
                <span class="text-[10px] text-neutral-600 uppercase tracking-widest border-r border-neutral-800 pr-4">Categorías:</span>
                {categories.map((cat) => (
                    <a href={`#${cat.id}`} class="flex-shrink-0 flex items-center gap-2 px-4 py-2 text-[11px] uppercase tracking-widest text-neutral-500 hover:text-amber-500 transition-all">
                        <Icon name={cat.icon} class="h-4 w-4" />
                        {cat.name}
                    </a>
                ))}
            </div>
        </div>

        <div class="space-y-32">
            {projectsByCategory.map((cat) => (
                cat.projects.length > 0 && (
                <div id={cat.id} class="scroll-mt-32">
                    <div class="flex items-end justify-between mb-10 border-b border-neutral-900 pb-6">
                        <div class="flex items-center gap-6">
                            <div class="h-16 w-16 flex items-center justify-center bg-amber-500/5 border border-amber-500/20 text-amber-500">
                                <Icon name={cat.icon} class="h-8 w-8" />
                            </div>
                            <div>
                                <h2 class="text-3xl font-black text-white uppercase tracking-tighter italic">{cat.name}</h2>
                                <p class="text-neutral-500 text-[10px] uppercase tracking-widest mt-1">{cat.desc}</p>
                            </div>
                        </div>
                        <a href={`/projects/${cat.id}`} class="group flex items-center gap-2 px-4 py-2 bg-neutral-900/50 border border-neutral-800 rounded text-[10px] font-mono text-amber-500 hover:border-amber-500/50 transition-all">
                            <span class="tracking-widest">[ EXPLORAR_TODO ]</span>
                            <Icon name="mdi:chevron-right" class="h-4 w-4 transition-transform group-hover:translate-x-1"/>
                        </a>
                        
                    </div>

                    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                        {cat.projects.map((project) => (
                            <ProjectCard project={project} />
                        ))}
                    </div>
                </div>
                )
            ))}
        </div>

        <div class="mt-32 border-2 border-dashed border-neutral-800 p-8 md:p-16 text-center relative overflow-hidden">
            <div class="absolute -top-4 -left-4 w-8 h-8 border-t-2 border-l-2 border-amber-500"></div>
            <div class="absolute -bottom-4 -right-4 w-8 h-8 border-b-2 border-r-2 border-amber-500"></div>

            <h3 class="text-2xl font-black text-white uppercase mb-4 tracking-tighter italic">¿PROTOTIPO_LISTO?</h3>
            <p class="text-neutral-500 text-sm max-w-lg mx-auto mb-10">
                Sincroniza tus esquemas, archivos STL y código fuente con el repositorio central .root
            </p>
            <a href="/comunidad/subir" class="inline-block bg-amber-500 px-10 py-4 text-xs font-black text-black uppercase tracking-widest hover:bg-white transition-all">
                SUBIR_PROYECTO.EXE
            </a>
        </div>
    </section>
</Layout>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
</style>