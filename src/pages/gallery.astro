---
import Layout from "@/layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import { Image } from "astro:assets";
import 'swiper/css';
import "swiper/css/navigation";
const allImages = await Astro.glob("../../public/images/gallery/*.*");
// allImages.forEach(image => console.log(image));
// console.log(allImages.length);
// Datos de la página
const title: string = "Galeria";
const subTitle: string = "";

// Función para extraer el nombre del archivo desde la URL
function getFileNameFromPath(path, separator = '/') {
    return path.split(separator).pop().split('?')[0];
}
---

<Layout>
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <TitleSection
                title={ title }
                subTitle={ subTitle }
            />
        </div>
        <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
            <!-- Contenedor principal de Swiper -->
            <div class="swiper w-auto">
                <!-- Wrapper adicional requerido -->
                <div class="swiper-wrapper w-auto lg:max-w-5xl xl:max-w-6xl xl:content-center">
                <!-- Los slides -->
                    {
                        allImages.map((image, index) => (
                        <a
                            class="swiper-slide overflow-hidden rounded-lg"
                            href={getFileNameFromPath(image.default.src,"public")}
                            target="_blank"
                            data-cropped="true"
                        >
                            <img src={getFileNameFromPath(image.default.src,"public")} alt={getFileNameFromPath(image.default.src)} class="object-cover w-full h-full"/>
                        </a>
                        ))
                    }
                </div>
                <!-- Si necesitamos botones de navegación -->
                <div class="swiper-button-prev hidden max-sm:w-14 max-sm:h-14 rounded-xl"></div>
                <div class="swiper-button-next hidden max-sm:w-14 max-sm:h-14 rounded-xl"></div>
            </div>
        </div>
    </section>
</Layout>
<style>
    /* .swiper-button-prev {
        transform: rotate(180deg); /* rotar arrow-next.svg para reutilizar el mismo icono*/
   /* } */
    /* .swiper-button-next::after,
    .swiper-button-prev::after {
        content: "";
    } */
</style>
<script>
    // Core de Swiper y estilos
    import Swiper from 'swiper';

    // Módulo Navigation de Swiper y estilos
    import { Navigation } from "swiper/modules";
    // import PhotoSwipeLightbox from 'photoswipe/lightbox';
    // import 'photoswipe/style.css';


    // Configurar Swiper
    const swiper = new Swiper(".swiper", {
        modules: [Navigation], // definir los módulos a usar
        loop: true,            // definir si los slides estarán en bucle
        slidesPerView: "auto",      // agregar número de slides para la pantalla
        spaceBetween: 40,      // separación entre slides en px
        breakpoints: {
            // Cuando la pantalla es >= 768px
            768: {
            slidesPerView: 2,
            spaceBetween: 30
            },
            // Cuando la pantalla es >= 1024px
            1024: {
            slidesPerView: 3,
            spaceBetween: 40
            }
        },
        navigation: {          // definir botones next y prev para el módulo Navigation
            prevEl: ".swiper-button-prev",
            nextEl: ".swiper-button-next",
        }
    });
    // const lightbox = new PhotoSwipeLightbox({
    //     gallery: '#my-slider',
    //     children: 'a',
    //     pswpModule: () => import('photoswipe')
    // });
    // lightbox.init();
</script>