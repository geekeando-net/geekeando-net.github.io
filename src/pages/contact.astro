---
import Layout from "@layouts/Layout.astro";
import TitleSection from "@/components/ui/TitleSection.astro";
import ContactCard from "@/components/ui/ContactCard.astro";
import ContactForm from "@/components/ui/ContactForm.astro";
import stringsCards from "@/utils/stringsCards";
import { Icon } from 'astro-icon/components';

const title = "COMM_UPLINK";
const subTitle = "// Estableciendo canal de comunicación con el laboratorio";
const stringsContact = stringsCards.stringsContact;
---
<Layout title="Contacto | Geekeando">
    <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
        <TitleSection title={title} subTitle={subTitle} />

        <div class="mt-12 grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 relative group flex flex-col">
                <div class="bg-neutral-900/40 border border-neutral-800 p-8 backdrop-blur-sm flex-grow relative overflow-hidden">

                    <div id="success-screen" class="hidden absolute inset-0 z-50 bg-neutral-950 flex flex-col items-center justify-center font-mono text-amber-500 p-8 text-center">
                        <p class="animate-pulse text-xl font-bold mb-4">> TRANSFERENCIA_EXITOSA</p>
                        <p class="text-[10px] opacity-70 mb-8 max-w-xs">Los datos han sido persistidos en el núcleo del sistema y un técnico revisará la señal pronto.</p>
                        <button onclick="window.location.reload()" class="border border-amber-500 px-6 py-2 text-[10px] hover:bg-amber-500 hover:text-black transition-all">
                            INICIAR_NUEVA_SESIÓN
                        </button>
                    </div>

                    <h2 class="text-lg font-bold text-amber-500 mb-6 flex items-center gap-3 tracking-tighter uppercase italic">
                        <Icon name="mdi:console-line" class="h-5 w-5 text-amber-500" />
                        Iniciar_Transmisión
                    </h2>

                    <ContactForm 
                        variant="standard" 
                        fields={['name', 'email', 'message']} 
                    />
                </div>
                <div class="absolute -top-2 -left-2 w-8 h-8 border-t-2 border-l-2 border-amber-500/50"></div>
            </div>

            <aside class="space-y-4">
                {stringsContact.map((item) => (
                    <ContactCard icon={item.icon} title={item.title} items={[item.text1, item.text2]} link={item.link} />
                ))}
            </aside>
        </div>
    </section>
</Layout>
